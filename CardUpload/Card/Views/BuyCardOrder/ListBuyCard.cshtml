@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<Card.Data.DTO.BuyCard>
<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {
            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">

                        <th>Mã giao dịch</th>
                        <th>Người mua</th>
                        <th>Nhà mạng</th>
                        <th>Mệnh giá</th>
                        <th>Số lượng</th>
                        <th>Số tiền</th>
                        
                        <th>Doanh thu sau chiết khấu</th>
                        @if (ViewBag.Type <= 2)
                        {
                            <th>Hoa hồng đại lý C1</th>
                        }
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th>Loại</th>
                        <th>Chi tiết</th>


                    </tr>
                </thead>
                @foreach (var obj in Model)
                {
            <tr>


                <td>@obj.Id</td>
                <td>@obj.UserName</td>
                <td>@obj.Telco</td>


                <td>@StringUtils.InsertCommaNoStyle(obj.CardValue.ToString())</td>
                <td>@obj.CardNumber</td>
                <td>@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                <td>@StringUtils.InsertCommaNoStyle(obj.Money.ToString())</td>
                @if (ViewBag.Type <= 2)
                {
                    <td>@StringUtils.InsertCommaNoStyle(obj.MoneyReward.ToString())</td>
                }

                <td>@string.Format("{0:dd/MM HH:mm}", obj.CreatedDate)</td>
                <td>@Html.Raw(HtmlHelpers.GetBuyCardtatus(obj.Status))</td>
                <td>
                    @if (obj.Type == 1)
                    {
                        <text> Web</text>
                    }
                    else
                    {
                        <text> API</text>
                    }
                </td>
                <td>
                    @if (obj.Status > 0)
                    {
                        <a onclick="ListCard('@obj.Id')" href="javascript:;">Xem mã thẻ</a>
                    }
                </td>

            </tr>
                }
            </table>
        }

    </div>
</div>
<script>
    function ListCard(OrderNo) {
        var url = "/BuyCardOrder/ListCardInfo/" + OrderNo;
        var confirmFunc = "";
        Utils.PopupManager(url, confirmFunc);
    }
</script>