
@{
    ViewBag.Title = "Danh sách tin tức";
}



<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><i class="fa fa-wrench"></i>Danh Sách Tin Tức</div>
            <div class="box-body">
                <div class="row" id="form">
                    <div class="col-md-12">

                        <div class="form-group col-md-3 col-xs-12 col-sm-6">
                            <label for="ddlStatus" class="control-label">Trạng thái</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <select class="form-control" id="ddlStatus">
                                    <option value="-1">Trạng Thái</option>
                                    <option value="1">Hoạt động</option>
                                    <option value="0">Khóa</option>

                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-3 col-xs-12 col-sm-6">
                            <label for="txtEmail" class="control-label"><i class="fa fa-pencil"></i>Từ Khóa</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <input type="text" id="txtEmail" class="form-control" placeholder="Nhập từ khóa">
                            </div>
                        </div>
                        <div class="form-group submit" style="text-align:center">
                            <button type="button" id="btnSearch" class="btn btn-primary">Tìm Kiếm</button>
                            <a href="@Url.Action("AddContentInfo")" class="btn btn-primary">Thêm mới</a>

                        </div>
                    </div>
                </div>
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListContent">
                        @Html.Action("ListContent")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlActive").change(function () {
            GetList(1);
        });

        function GetList(currentPage) {
            parameters = {
                isActive: $('#ddlActive :selected').val(),
                email: $("#txtEmail").val(),
                currentPage: currentPage
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {

            var urlRequestAns = "/AdminContent/ListContent";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListContent").html(data);

                },
                error: function () {

                }
            });
        }


    });

    });
</script>
