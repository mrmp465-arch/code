@using Card.Data.DTO
@model Contents

    <script type="text/javascript" src="~/ckeditor/ckeditor.js"></script>

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header">
                @if (Model.Id > 0)
                {
                    <i class="fa fa-fw fa-user-md"></i><span>Cập Nhật bài viết</span>
                }
                else
                {
                    <i class="fa fa-fw fa-user-plus"></i><span>Thêm mới bài viết</span>
                }
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label id="ErrorMessage">Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel">

                        <div class="form-body">
                            <div class="form-group">
                                <label for="txtUserName" class="control-label col-md-3">Tên :<span class="required">*</span></label>
                                <div class="col-md-7">
                                    <div class="input-icon right">
                                        <input type="text" id="txtTitle" maxlength="150" name="title" value="@Model.Title" class="form-control" placeholder="Nhập tiêu đề" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" >
                                <label for="txtUserName" class="control-label col-md-3">Nội dung :<span class="required">*</span></label>
                                <div class="col-md-7">
                                    <div class="input-icon right">
                                        <textarea id="txtDescription" style="height: 100px;" cols="20" name="description" class="form-control">@Model.Description</textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="txtPublicTime" class="control-label col-md-3">Thời gian xuất bản :<span class="required">*</span></label>
                                <div class="col-md-6">
                                    <div class="input-icon right">
                                        <input type="text" id="txtPublishDate" data-format="DD/MM/YYYY HH:mm" value="@Model.PublishDate.ToString("dd/MM/yyyy HH:mm")" name="publictime" class="form-control" />

                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                <div class="col-md-6">
                                    <div class="checkbox">
                                        <input type="checkbox" id="cbxIsActive" class="cbxIsDisplay" @(Model.Status == 1 ? "checked=\"checked\"" : "") />

                                    </div>
                                </div>
                            </div>
                            <div class="form-group" style="display:none">
                                <label class="control-label col-md-3" for="cbxIsHot">Ghim đầu trang :</label>
                                <div class="col-md-6">
                                    <div class="checkbox">
                                        <input type="checkbox" id="cbxIsHot" class="cbxIsDisplay" @(Model.IsHot == 1 ? "checked=\"checked\"" : "") />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel-footer form-horizontal">
                            <div class="form-group submit">
                                <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-save"></i> Lưu lại</button>
                                <button type="button" class="btn btn-primary" id="btnReset"><i class="fa fa-refresh"></i> Làm mới</button>
                                <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i> Back</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">
    function GotoListpage() {
        window.location = "@Url.Action("Index")";
    }
    $(document).ready(function () {
        var editor = CKEDITOR.instances['txtDescription'];
        if (editor) {
            CKEDITOR.remove(editor);
        }
        CKEDITOR.replace('txtDescription', {
            filebrowserBrowseUrl: "",
            filebrowserWindowWidth: '600',
            filebrowserWindowHeight: '200',
            uiColor: '#FAFAFA',
            allowedContent: true,
            extraAllowedContent: '*(*)',
            // ALLOW <i></i>

            //extraAllowedContent: 'p(*)[*]{*};div(*)[*]{*};li(*)[*]{*};ul(*)[*]{*}',
            extraPlugins: 'youtube,tableresize',
            toolbar: [
             { name: 'document', items: ['Source', '-', 'NewPage', 'Preview', '-'] },
             ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'],
            { name: 'styles', items: ['Font', 'FontSize'] },
            { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },

            '/',
            { name: 'colors', items: ['TextColor', 'BGColor'] }, { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock'] },
            { name: 'insert', items: ['Youtube', 'Table', 'HorizontalRule', 'PageBreak', 'Iframe'] },
            { name: 'links', items: ['Link', 'Unlink', 'Maximize'] }
            ],
            height: 200
        });

             $('#txtPublicTime').datetimepicker({
                format: 'DD/MM/YYYY HH:mm',
                inline: true,
                sideBySide: true,
                showTodayButton: true
            });

            $("button.close").click(function () {
                $(this).parent().css("display", "none");
            });
            $('#defaultForm').bootstrapValidator({
                message: 'This value is not valid',
                //live: 'submitted',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok',
                    invalid: 'glyphicon glyphicon-remove',
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {

                    title: {
                        message: 'The name is not valid',
                        validators: {
                            notEmpty: {
                                message: 'tiêu đề không được bỏ trống'
                            },

                            stringLength: {
                                min: 3,
                                max: 30,
                                message: 'tiêu đề nhỏ nhất 3 ký tự và nhiều nhất 150 ký tự'
                            },

                        }
                    },

                }
            })
            .on('success.form.bv', function (e) {
                // Prevent submit form
                e.preventDefault();

                var $form = $(e.target),
                    validator = $form.data('bootstrapValidator');
                SaveData();
                $(".close").click(function () {
                    $(".alert-success").css("display", "none");
                });
            })
            .on('error.form.bv', function (e) {
                // Active the panel element containing the first invalid element
                e.preventDefault();
                var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
                $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
                $(".alert-danger").css("display", "block");
                $(".close").click(function () {
                    $(".alert-danger").css("display", "none");
                    $(".alert-success").css("display", "none");
                });
            });

            $("#btnReset").click(function () {
                $('#defaultForm').data('bootstrapValidator').resetForm(true);
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
            //Save Data
            function SaveData() {
                var param = {
                    'Id': '@Model.Id',
                    'Title': $("#txtTitle").val(),
                    'Description':CKEDITOR.instances['txtDescription'].getSnapshot(),
                    'SPublishDate': $("#txtPublishDate").val(),
                    'IsHot': $("#cbxIsHot").is(":checked") ? 1 : 0,
                    'Status': $("#cbxIsActive").is(":checked") ? 1 : 0
                }
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("SaveData")",
                    data: addAntiForgeryToken(param),
                    async: true,
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            $(".alert-success").show("slow");
                            $(".alert-danger").hide("slow");
                            setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 2000);
                        }
                        else {

                            $("#ErrorMessage").text(data.Description);
                            $(".alert-danger").show("slow");
                            $(".alert-success").hide("slow");
                            setTimeout(function () { $(".alert-danger").hide("slow"); }, 5000);
                        }
                    }
                });
            };
        });

        @*var activemenu = $('.sidebar-menu #menu_@(permission.FunctionID)');
        activemenu.addClass("active");*@

</script>
