@using Card.Data.DTO;
@using Card.Utility
@model List<BankGateAPI>
@using Card.CMS.Helper
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>TransId</th>
            @if (ViewBag.UserType == 1)
            {
                <th>User</th>
            }

            <th>Số tiền</th>
            <th>BankCode</th>
            <th>Tài khoản nhận</th>

            <th>Nội dung</th>
            <th>Time</th>
            <th>LastTime</th>
            <th>Trạng thái</th>

        </tr>
    </thead>
    @if (Model.Count > 0)
    {
        foreach (var obj in Model)
        {

<tr>

    <td style="text-align:left;">@obj.TransactionID</td>
    @if (ViewBag.UserType == 1)
    {
        <td style="text-align:left;">@obj.UserName</td>
    }

    <td style="text-align:left;">@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString().Replace(".00", ""))/@StringUtils.InsertCommaNoStyle(obj.Amount.ToString().Replace(".00", ""))</td>

    <td style="text-align:left;">@obj.BankCode</td>
    <td style="text-align:left;">@obj.BankAccountNumber -@obj.BankAccountName</td>


    <td style="text-align:left;">@obj.OrderNo</td>

    <td>@string.Format("{0:dd/MM/yyyy HH:mm:ss}", obj.CreatedTime)</td>
    <td>@string.Format("{0:dd/MM/yyyy HH:mm:ss}", obj.LastTime)</td>

    
    <td>@Html.Raw(HtmlHelpers.GetTranStatus(obj.Status))</td>
</tr>

        }
    }
</table>
<script>
    function BindDataRequest() {
        return;
    }


</script>