@using Card.Data.DTO;
@{

    List<Users> PartList = ViewBag.PartList;
}
<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">Đối soát</div>
            <div class="box-body">
                <div class="row" id="form">

                    <div class="form-group col-md-3 col-xs-12 col-sm-6" @if (PartList.Count == 1) { @Html.Raw("style='display:none'") ; }>
                        <label class="control-label">Tài khoản</label>
                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                            <select class="form-control " id="ddlPartner">
                                @if (PartList != null && PartList.Count > 0)
                                {
                                    foreach (var obj in PartList)
                                    {
                                        <option value="@obj.UserID">@obj.Username</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>



                    <div class="form-group col-md-3 col-xs-12 col-sm-6" id="datetimepicker_FromDate">
                        <label class="control-label text-info" style="min-width:60px;"><i class="fa fa-calendar"></i>Từ Ngày</label>
                        <div class="col-xs-8 col-md-8 col-sm-8 col-xs-12">
                            <div class="date" id="datetimeFromDate">
                                <input type="text" data-date-format="DD/MM/YYYY" id="fromDate" class="form-control" name="datetimeFromDate" />

                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" id="datetimepicker_ToDate">
                        <label class="control-label text-info" style="min-width:60px;"><i class="fa fa-calendar"></i>Đến Ngày</label>
                        <div class="col-xs-8 col-md-8 col-sm-8 col-xs-12">
                            <div class="date" id="datetimeToDate">
                                <input type="text" data-date-format="DD/MM/YYYY" id="toDate" class="form-control" name="datetimeToDate" />

                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-2 col-xs-12 col-sm-6">
                        <input type="button" id="btnSearch" class="btn btn-warning" value="Xem">
                        <button type="button" id="btn_export" class="btn btn-success">Xuất Excel</button>
                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListUserLog">
                            @*@Html.Action("ListUserLog", "System")*@
                        </div>

                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
       $('#datetimeFromDate').datetimepicker({
            pickTime: false,
            autoclose: true
        });
        $('#datetimeToDate').datetimepicker({
            pickTime: false,
            autoclose: true
        });
        var fromdate = '@string.Format("{0:dd/MM/yyyy}", ViewBag.fromDate)';
        var todate = '@string.Format("{0:dd/MM/yyyy}", ViewBag.toDate)';
        $('#datetimeFromDate').data("DateTimePicker").setDate(fromdate);
        $('#datetimeToDate').data("DateTimePicker").setDate(todate);

        $("#datetimeFromDate").on("dp.change dp.show", function (e) {
            $('#datetimeToDate').data("DateTimePicker").setMinDate(e.date);
        });
        $("#datetimeToDate").on("dp.change dp.show", function (e) {
            $('#datetimeFromDate').data("DateTimePicker").setMaxDate(e.date);
        });

        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        //$("#ddlStatus").change(function () {
        //    GetList(1);
        //});
        //$("#ddlCardType").change(function () {
        //    GetList(1);
        //});
        //$("#ddlProvider").change(function () {
        //    GetList(1);
        //});
        //$("#ddlPartner").change(function () {
        //    GetList(1);
        //});
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        function GetList(currentPage) {
            parameters = {
                'FromDate': $("#fromDate").val(),
                'ToDate': $("#toDate").val(),
                'useId': $("#ddlPartner").val(),

            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();

            var urlRequestAns =  "@Url.Action("ListBankLogDS")";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListUserLog").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }
         $("#btn_export").click(function () {

             var urlRequestAns = "@Url.Action("ListBankLogDSExcel")?FromDate=" + $("#fromDate").val() + "&ToDate=" + $("#toDate").val() + "&useId=" + $("#ddlPartner").val();

            window.location = urlRequestAns;

        });
        GetList(1);
    });

</script>
