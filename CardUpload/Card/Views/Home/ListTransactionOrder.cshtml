@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<OrderOutput>
<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {

            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">
                        <th>Trạng thái</th>
                        @*<th>TransID</th>*@

                        <th>Mobile</th>
                        <th>Telco</th>
                        @*<th>Nạp 199</th>*@
                        <th>Amount</th>
                        @*<th>AmountMin</th>*@
                        @*<th>MinAll</th>*@
                        <th>Phí đua</th>
                        <th>Ck đua</th>
                        <th>Trạng thái</th>
                        <th>Ngày</th>
                        <th>Tác vụ</th>
                    </tr>
                </thead>
                @if (Model.Count > 0)
                {
                    foreach (var obj in Model)
                    {
            <tr>
                <td>
                    @if (obj.Status == -2)
                    {
                        <div class="label label-md label-danger"><a onclick="GetDescription(@obj.TransactionID)" href="javascript:;">Telco khóa</a></div>
                    }
                    else
                    {
                        @Html.Raw(HtmlHelpers.GetTranStatus(obj.Status))
                    }

                </td>
                @*<td>@obj.TransactionID</td>*@


                <td>
                    @if ((obj.IsConfirm != 1) && ViewBag.UserName == obj.SubUser)
                    {

                        <a onclick="Update(@obj.TransactionID)" href="javascript:;">@obj.Mobile</a>

                    }
                    else
                    {
                        @obj.Mobile
                    }

                </td>

                <td>@HtmlHelpers.GetTelcoName(obj.Telco.ToUpper())-@HtmlHelpers.GetTopupType(obj.TopupType, obj.Telco.ToUpper())</td>
                @*<td>@(obj.Ussd == 0 ? "Không" : "Có")</td>*@

                <td>@StringUtils.InsertCommaNoStyle(obj.AmountTopupSuccess.ToString())/@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                @*<td>
            @obj.AmountMin
        </td>*@
                @*<td>
            @obj.AmountMinAll
        </td>*@
                <td> @StringUtils.InsertCommaNoStyle(obj.BidFee.GetValueOrDefault().ToString())</td>
                <td>@string.Format("{0:F0}", obj.BidRate.GetValueOrDefault()) </td>
                <td>@(obj.IsConfirm == 0 ? " Chưa chốt" : " Đã chốt")</td>
                <td>@string.Format("{0:dd/MM}", obj.LastTime)</td>
                <td style="text-align:right">

                    @if (obj.IsConfirm != 1)
                    {

                        if ( obj.Status == 1 || obj.Status == -6)
                        {
                            <span class="label label-danger">
                                <a onclick="Lock('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Dừng nạp</a>
                            </span><text>&nbsp;</text>
                        }
                        if (obj.Status == -3)
                        {
                            <span class="label label-info"><a onclick="ResetTran('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Mở</a></span>
                        }
                    }
                    @if (( obj.Status == 1) && (obj.IsConfirm != 1) && (obj.Telco.ToUpper() != "ZING" && obj.Telco.ToUpper() != "GARENA") && obj.AmountTopupSuccess < obj.Amount)
                    {
                        <span class="label label-warning">
                            <a onclick="BidTran('@obj.TransactionID','@obj.OrderNo')" href="javascript:;">Đua giá</a><text>&nbsp;</text>
                        </span>
                    }
                    @if (obj.IsConfirm != 1 && obj.Status != 2)
                    {
                        <span class="label label-success">
                            <a onclick="ConfirmOrder('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Chốt</a>
                        </span>

                    }

                    @if (obj.AmountTopupSuccess > 0)
                    {
                        <span class="label label-info">
                            <a onclick="HistoryUser(@obj.TransactionID)" href="javascript:;">Xem </a><text>&nbsp;</text>
                        </span>
                    }
                    <span class="label label-info">
                        <a onclick="HistoryBid(@obj.TransactionID)" href="javascript:;">LS đua giá</a>
                    </span>


                </td>
            </tr>
                    }
                }
            </table>
        }
    </div>
</div>
<script>
    function GetDescription(id) {
        var url = "/Order/GetDescription/" + id;
        var confirmFunc = null;
        Utils.PopupManager(url, confirmFunc);
    }
    function Update(id) {
        var url = "/Order/Edit/" + id;
        var confirmFunc = null;
        Utils.PopupManager(url, confirmFunc);
    }
    function HistoryBid(id) {
        var url = "/Home/BidHistory/" + id;
        var confirmFunc = null;
        Utils.PopupManager(url, confirmFunc);
    }
    function BidTran(id) {
        var url = "/Home/OrderBid/" + id;
        var confirmFunc = null;
        Utils.PopupManager(url, confirmFunc);
    }
    function ResetTran(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn mở đơn  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ResetTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function Lock(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn tạm dừng  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/LockTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {

                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function ConfirmOrder(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chốt  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ConfirmTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {

                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                location.reload();
            });
    }
    function HistoryUser(id) {
        var url = "/Order/ListTransactionHistory/?transId=" + id;
        var confirmFunc = "";
        Utils.PopupManager(url, confirmFunc);
    }
    //showmess("Lỗi nhập sai OTP!", "error", "btn-danger");
    //showmess("Giao dịch thành công!", "success", "btn-success");
</script>