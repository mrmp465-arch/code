@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<Card.Data.DTO.CardOrder>

<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon"></span>Danh sách thẻ </div>
            <div class="box-body">

                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        @if (Model != null && Model.Count > 0)
                        {
                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                <thead>
                                    <tr class="rowsao">

                                        <th>Nhà mạng</th>
                                        <th>Mệnh giá</th>
                                        <th>Mã thẻ</th>
                                        <th>Seri</th>

                                        @*<th>Ngày tạo</th>*@



                                    </tr>
                                </thead>
                                @foreach (var obj in Model)
                                {
                            <tr>

                                <td>@obj.Telco</td>

                                <td>@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                                <td>@obj.CardCode</td>
                                <td>@obj.CardSerial</td>


                                @*<td>@string.Format("{0:dd/MM}", obj.CreatedDate)</td>*@


                            </tr>
                                }
                            </table>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style type="text/css">
    .modal-dialog {
        width: 80% !important;
        height: 80% !important;
    }

    .admountHiden {
        display: none;
    }
</style>





