
@using Card.Utility
@using Card.CMS.Models
@model List<DataReport>
@if (Model != null)
{
    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>

           
            <tr>
                <th>Ngày</th>
                <th>BankIn</th>

                <th>BankOut</th>
                <th>Tổng</th>
            </tr>
            @foreach (var item in Model)
            {

                <tr>
                    <td>@item.Time</td>

                    <td>@item.TotalBank.ToString("N0") </td>
                   
                    <td>@item.TotalBankOut.ToString("N0") </td>
                    
                    <td>@item.Total.ToString("N0") </td>
                </tr>

            }
            <tr>
                <td><b>Tổng</b></td>
               
                <td><b>@Model.Sum(x => x.TotalBank).ToString("N0")</b></td>
                
                <td><b>@Model.Sum(x => x.TotalBankOut).ToString("N0")</b></td>
               
                <td><b>@Model.Sum(x => x.Total).ToString("N0")</b></td>
            </tr>

        </thead>
    </table>
}

