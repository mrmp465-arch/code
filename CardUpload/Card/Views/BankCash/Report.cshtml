@using Card.Data.DTO;
@{

    List<Users> PartList = ViewBag.PartList;
}
<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">Báo cáo giao dịch rút </div>
            <div class="box-body">
                <div class="row" id="form">

                    <div class="form-group col-md-3 col-xs-12 col-sm-6" @if (PartList.Count == 1) { @Html.Raw("style='display:none'") ; }>
                        <label class="control-label">Tài khoản</label>
                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                            <select class="form-control " id="ddlPartner">
                                @if (PartList != null && PartList.Count > 0)
                                {
                                    foreach (var obj in PartList)
                                    {
                                        <option value="@obj.UserID">@obj.Username</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-1 col-xs-12 col-sm-6">
                        <select class="form-control " id="ddlYear">

                            @for (var i = 2021; i <= DateTime.Now.Year; i++)
                            {

                                if (i == DateTime.Now.Year)
                                {
                                    <option value="@i" selected="selected"> @(i)</option>
                                }
                                else
                                {
                                    <option value="@i"> @(i)</option>
                                }

                            }
                        </select>
                    </div>
                    <div class="form-group col-md-1 col-xs-12 col-sm-6">
                        <select class="form-control " id="ddlMonth">

                            @for (var i = 1; i <= 12; i++)
                            {

                                if (i == DateTime.Now.Month)
                                {
                                    <option value="@i" selected="selected"> @(i)</option>
                                }
                                else
                                {
                                    <option value="@i"> @(i)</option>
                                }

                            }
                        </select>
                    </div>
                    <div class="form-group col-md-1 col-xs-12 col-sm-6">
                        <select class="form-control " id="ddlDay">
                            <option value="0">Ngày</option>
                            @for (var i = 1; i <= 31; i++)
                            {

                                if (i == DateTime.Now.Day)
                                {
                                    <option value="@i" selected="selected"> @(i)</option>
                                }
                                else
                                {
                                    <option value="@i"> @(i)</option>
                                }

                            }
                        </select>
                    </div>


                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="button" id="btnSearch" class="btn btn-warning" value="Xem">

                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListUserLog">
                            @*@Html.Action("ListUserLog", "System")*@
                        </div>

                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {

        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlStatus").change(function () {
            GetList(1);
        });
        $("#ddlCardType").change(function () {
            GetList(1);
        });
        $("#ddlProvider").change(function () {
            GetList(1);
        });
        $("#ddlPartner").change(function () {
            GetList(1);
        });
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        function GetList(currentPage) {
            parameters = {

                'Year': $("#ddlYear").val(),
                'Month': $("#ddlMonth").val(),
                'Day': $("#ddlDay").val(),
                //'cardType': $("#ddCardType").val(),
                'useId': $("#ddlPartner").val(),
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns =  "@Url.Action("ListBankReport")";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListUserLog").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }
        GetList(1);
    });

</script>
