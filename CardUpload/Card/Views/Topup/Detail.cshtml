@using Card.Data.DTO
@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<Card.Data.DTO.TopupOrder>
<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">
                <span class="glyphicon glyphicon-user"></span>
                @ViewBag.Title
            </div>
            <div class="box-body">
                <div class="row">

                    @if (ViewBag.IsFullControl && (ViewBag.Confirm > 0))
                    {
                        <div class="form-group submit col-md-8 col-xs-12 col-sm-6">
                            <div class="form-group">
                                <label for="fileName" class="text-info ng-binding">Upload file kết quả</label>
                                <input type="file" id="excelfile" uploader="uploader" name="fileName">
                                <div style="font-weight:bold;margin-top:10px">
                                    Kết quả giao dịch 1 thành công , -1 thất bại
                                    <span style="color:red">
                                        <br>
                                        - Trước khi mang đơn đi xử lý, phải chuyển các giao dịch từ đợi nạp về đang xử lý
                                        <br>
                                        - Đơn đã chốt rồi thì không cập nhật được kết quả
                                        <br>
                                        
                                    </span>
                                </div>
                            </div>

                            <div class="form-group">

                                <img src="~/Content/TopupOrderResult.PNG?vs=?vs=2023" style="width:100%" />

                            </div>



                            <div class="form-group submit">
                                <button type="button" class="btn btn-primary" onclick="validateData()" id="btnSave"><i class="fa fa-save"></i> Lưu</button>


                            </div>

                        </div>
                    }

                    @if (ViewBag.IsFullControl)
                    {
                        <div class="form-group submit col-md-3 col-xs-12 col-sm-6 pull-right" style="text-align:center">
                            <button type="button" id="btn_export" class="btn btn-primary pull-right">
                                <i class="fa fa-file-excel-o"></i> Download
                            </button>
                        </div>


                    }

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-responsive">
                            <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                                <div id="ListOrderActive">
                                    @if (Model != null && Model.Count > 0)
                                    {

                                        <div class="pull-right">
                                            Tổng tiền:
                                            <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.AmountSuccess).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.Amount).ToString()) </b>

                                        </div>
                                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                            <thead>
                                                <tr class="rowsao">

                                                    <th>Trạng thái</th>
                                                    <th>TransId</th>
                                                    <th>Mã đơn</th>
                                                    <th>Nhà mạng</th>
                                                    <th>SDT</th>
                                                    <th>Loại đơn</th>
                                                    <th>Mện giá nạp</th>
                                                    <th>Số tiền</th>
                                                    <th>Thực nhận</th>
                                                    @if (ViewBag.Type != "3")
                                                    {
                                                        <th>Hoa hồng</th>
                                                    }
                                                    <th>Đua giá</th>
                                                    <th>Phí đua giá</th>
                                                    <th>Ngày tạo</th>
                                                    <th>Ngày cập nhật</th>
                                                    <th>Chốt</th>

                                                </tr>
                                            </thead>
                                            @foreach (var obj in Model)
                                            {
                                        <tr>
                                            <td>@Html.Raw(HtmlHelpers.GetTranOrder(obj.Status))</td>
                                            <td>@obj.Id</td>
                                            <td>@obj.OrderNo</td>



                                            <td>@obj.Telco</td>
                                            <td>@obj.Account</td>
                                            <td>@obj.TopupType</td>
                                            <td>@obj.CardValue</td>
                                            <td>@StringUtils.InsertCommaNoStyle(obj.AmountSuccess.ToString())/@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                                            <td>@StringUtils.InsertCommaNoStyle(obj.Money.ToString())</td>
                                            @if (ViewBag.Type != "3")
                                            {
                                                <td>@StringUtils.InsertCommaNoStyle(obj.MoneyReward.ToString())</td>
                                            }
                                            <td>@obj.Priority</td>
                                            <td>@StringUtils.InsertCommaNoStyle(obj.MoneyPriority.ToString())</td>
                                            <td>@string.Format("{0:dd/MM HH:mm}", obj.CreatedDate)</td>
                                            <td>@string.Format("{0:dd/MM HH:mm}", obj.UpdateDate)</td>
                                            <td class="noExl" style="text-align:right">
                                                @if (obj.IsConfirm == 1)
                                                {
                                                    <text>Đã chốt</text>
                                                }
                                                else
                                                {
                                                    <text>Chưa chốt</text>
                                                }
                                            </td>
                                        </tr>
                                            }
                                        </table>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        $("#btn_export").click(function () {
            var data = {
                orderNo: '@ViewBag.OrderNo',


            };
            var urlRequestAns = "/Topup/Download?OrderNo=" + data.orderNo;

            window.location = urlRequestAns;

        });
    });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.7.7/xlsx.core.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xls/0.7.4-a/xls.core.min.js"></script>
<script>

    function validateData() {


        ExportToTable();
    }
    function ExportToTable() {
        var regex = /^(.*?)+(.xlsx|.xls)$/;
        /*Checks whether the file is a valid excel file*/
        if (regex.test($("#excelfile").val().toLowerCase())) {
            var xlsxflag = false; /*Flag for checking whether excel is .xls format or .xlsx format*/
            if ($("#excelfile").val().toLowerCase().indexOf(".xlsx") > 0) {
                xlsxflag = true;
            }
            /*Checks whether the browser supports HTML5*/
            if (typeof (FileReader) != "undefined") {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var data = e.target.result;
                    /*Converts the excel data in to object*/
                    if (xlsxflag) {
                        var workbook = XLSX.read(data, { type: 'binary' });
                    }
                    else {
                        var workbook = XLS.read(data, { type: 'binary' });
                    }
                    /*Gets all the sheetnames of excel in to a variable*/
                    var sheet_name_list = workbook.SheetNames;

                    var cnt = 0; /*This is used for restricting the script to consider only first sheet of excel*/
                    sheet_name_list.forEach(function (y) { /*Iterate through all sheets*/
                        /*Convert the cell value to Json*/
                        if (xlsxflag) {
                            var exceljson = XLSX.utils.sheet_to_json(workbook.Sheets[y]);
                        }
                        else {
                            var exceljson = XLS.utils.sheet_to_row_object_array(workbook.Sheets[y]);
                        }
                        if (exceljson.length > 0 && cnt == 0) {
                            var jsonResult = BindTable(exceljson);
                            SaveData(jsonResult);
                            cnt++;



                        }
                    });
                    $('#exceltable').show();
                }
                if (xlsxflag) {/*If excel file is .xlsx extension than creates a Array Buffer from excel*/
                    reader.readAsArrayBuffer($("#excelfile")[0].files[0]);
                }
                else {
                    reader.readAsBinaryString($("#excelfile")[0].files[0]);
                }
            }
            else {
                alert("Sorry! Your browser does not support HTML5!");
            }
        }
        else {
            alert("Please upload a valid Excel file!");
        }
    }
    function SaveData(jsonResult)
    {
        //let TotalAmount = 0;
        //for (var i = 0; i < jsonResult.length; i++) {
        //    if (isNaN(jsonResult[i].Amount)) {
        //        continue;
        //    }
        //    TotalAmount += parseInt(jsonResult[i].Amount);
        //}

        var datatemp = "<br><br><b>Dữ liệu mẫu</b> TransId: " + jsonResult[0].Id;
        datatemp += "| Nhà mạng:" + jsonResult[0].Telco;
        datatemp += "| SDT:" + jsonResult[0].Account;

        datatemp += "| Số tiền:" + jsonResult[0].Amount;
        datatemp += "| Loại đơn:" + jsonResult[0].TopupType;
        datatemp += "| Mệnh giá nạp:" + jsonResult[0].CardValue;
        datatemp += "| Ưu tiên:" + jsonResult[0].Priority;
        datatemp += "| Số tiền thành công:" + jsonResult[0].AmountSuccess;
        datatemp += "| Kết quả:" + jsonResult[0].Status;
       /* datatemp += "<br><b>Tổng số tiền :" + TotalAmount + "</b> ";*/

       /* datatemp += "| <br><b>Tổng số tiền :" + TotalAmount +"</b> ";*/
          //datatemp += "| 199:" + jsonResult[0].Ussd;
        bootbox.confirm("<b>Bạn chắc chắn tạo file ???</b> " + datatemp, function (result) {
            if (!result) {
                return;
            }
             $.ajax({
                type: 'POST',
                url: "@Url.Action("TopupOrder")",
                 data: JSON.stringify(jsonResult),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                async: true,
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {

                        $('.modal ').modal('hide');

                        location.reload();
                    }
                    else {

                        showmess(data.Description, "error", "btn-danger");
                    }
                }
            });
        });

    }
    function BindTable(jsondata) {/*Function used to convert the JSON array to Html Table*/
        var columns = BindTableHeader(jsondata); /*Gets all the column headings of Excel*/
        var jsonResult = [];
        var columnId = 0;
        var columnTelco = 1;
        var columnAccount = 2;
        var columnTopupType = 4;
        var columnAmount = 3;
        var columnCardvl = 5;

        var columnPriority = 6;
        var columnPassword = 7;
        var columnAmountSuccess = 8;
        var columnStatus  = 9;
        console.log(jsondata);
        for (var i = 0; i < jsondata.length; i++) {

            var param = {
                'Id': jsondata[i][columns[columnId]] != undefined ? jsondata[i][columns[columnId]] : '0',
                'CardValue': jsondata[i][columns[columnCardvl]] ,
                'Account': jsondata[i][columns[columnAccount]] != undefined ? jsondata[i][columns[columnAccount]] : '',
                'Telco': jsondata[i][columns[columnTelco]] != undefined ? jsondata[i][columns[columnTelco]] : '',
                'TopupType': jsondata[i][columns[columnTopupType]] != undefined ? jsondata[i][columns[columnTopupType]] : '',
                'Amount': jsondata[i][columns[columnAmount]]  != undefined ?  jsondata[i][columns[columnAmount]] : '0',
                'Priority': jsondata[i][columns[columnPriority]] != undefined ? jsondata[i][columns[columnPriority]] : '0',
                'Password': jsondata[i][columns[columnPassword]] != undefined ? jsondata[i][columns[columnPassword]] : '',
                'Status': jsondata[i][columns[columnStatus]] != undefined ? jsondata[i][columns[columnStatus]] : '0',
                'AmountSuccess': jsondata[i][columns[columnAmountSuccess]] != undefined ? jsondata[i][columns[columnAmountSuccess]] :'0'
            };

            //console.log(jsondata[i][columns[columnAmountMin]]);
            //console.log(param);
            if (param.Mobile != '') {
                jsonResult.push(param);
            }
            //var row$ = $('<tr/>');
            //for (var colIndex = 0; colIndex < columns.length; colIndex++) {
            //    var cellValue = jsondata[i][columns[colIndex]];
            //    //if (cellValue == null)
            //    //    cellValue = "";
            //    row$.append($('<td/>').html(cellValue));
            //}
            //$(tableid).append(row$);
        }
        return jsonResult;
    }
    function BindTableHeader(jsondata) {/*Function used to get all column names from JSON and bind the html table header*/
        var columnSet = [];
        //var headerTr$ = $('<tr/>');
        for (var i = 0; i < jsondata.length; i++) {
            var rowHash = jsondata[i];
            for (var key in rowHash) {
                if (rowHash.hasOwnProperty(key)) {
                    if ($.inArray(key, columnSet) == -1) {/*Adding each unique column names to a variable array*/
                        columnSet.push(key);
                        //headerTr$.append($('<th/>').html(key));
                    }
                }
            }
        }
        //$(tableid).append(headerTr$);
        return columnSet;
    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                location.reload();
            });
    }
</script>