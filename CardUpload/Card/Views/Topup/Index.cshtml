@using Card.Data.DTO
@{
    List<Users> ListUser = ViewBag.UserList;

}

<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">
                <span class="glyphicon glyphicon-user"></span>
                @ViewBag.Title
            </div>
            <div class="box-body">
                <div class="row" id="form">

                    <div class="form-group col-md-2 col-xs-12 col-sm-6" id="search_input">
                    </div>
                    <div class="form-group col-md-2 col-xs-12 col-sm-6">
                        <label class="control-label">Bản ghi</label>
                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                            <select class="form-control" id="ddlTop">



                                <option value="500">500</option>
                                <option value="1000">1000</option>

                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" @if (ListUser.Count == 1) { @Html.Raw("style='display:none'") ; }>

                        <div class="col-lg-12 col-md-12 col-sm-8 col-xs-12">
                            <label class="control-label">Người tạo</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <select class="form-control dlUser" id="ddlUser">
                                    @if (ListUser != null && ListUser.Count > 0)
                                    {
                                        foreach (var obj in ListUser)
                                        {
                                            <option value="@obj.Username">@obj.Username</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <label class="control-label">Mã đơn</label>
                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                            <input type="text" id="txtEmail" class="form-control" placeholder="Mã đơn">
                        </div>
                    </div>

                    <div class="form-group col-md-2 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-primary">Tìm Kiếm</button>


                    </div>



                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-responsive">
                            <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                                <div id="ListOrderActive">

                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });

        $("#ddlTop").change(function () {
            GetList(1);
        });
        $("#ddlUser").change(function () {
            GetList(1);
        });

        function GetList(currentPage) {
            parameters = {

                orderNo: $("#txtEmail").val(),

                username: $("#ddlUser").val(),
                top: $("#ddlTop").val(),

            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {

            var urlRequestAns = "/Topup/ListOrder";
            Utils.Loading();
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    Utils.UnLoading();
                    $("#ListOrderActive").html(data);

                },
                error: function () {

                }
            });
        }
        GetList(1);

    });
</script>
