@using Card.CMS.Models
@using Card.CMS.Helper
@using Card.Utility
@model List<Card.Data.DTO.TopupOrderReport>

<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {

            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">
                        <th>Ngày</th>
                        <th>Số giao dịch</th>
                        <th>Tổng doanh số</th>
                        <th>Doanh thu sau chiết khấu</th>
                        @if (ViewBag.Type <= 2)
                        {
                            <th>Hoa hồng cấp 1</th>
                        }
                        <th>Doanh thu đua giá</th>


                    </tr>
                </thead>
                @if (Model.Count > 0)
                {
                    foreach (var obj in Model)
                    {
            <tr>
                <td>@StringUtils.FormatDay(obj.Data)</td>
                <td>@obj.TotalTrans</td>
                <td>@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
                <td><b>@StringUtils.InsertCommaNoStyle(obj.TotalRevenue.ToString())</b></td>
                @if (ViewBag.Type <= 2)
                {
                    <td><b>@StringUtils.InsertCommaNoStyle(obj.TotalReward.ToString())</b></td>
                }
                <td><b>@StringUtils.InsertCommaNoStyle(obj.TotalMoneyPriority.ToString())</b></td>

            </tr>
                    }
            <tr>
                <td><b>Tổng</b></td>
                <td><b>@Model.Sum(x => x.TotalTrans)</b></td>
                <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())</b></td>
                <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalRevenue).ToString())</b></td>
                @if (ViewBag.Type <= 2)
                {
                    <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalReward).ToString())</b></td>
                }
                <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalMoneyPriority).ToString())</b></td>
            </tr>
                }
            </table>
        }
    </div>
</div>



