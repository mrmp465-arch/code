@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<Card.Data.DTO.TopupOrderGroup>

@if (Model != null && Model.Count > 0)
{
    <div class="pull-right">
        Tổng tiền:
        <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmountSuccess).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString()) </b>
    </div>
    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>
            <tr class="rowsao">

               
                <th>Mã đơn</th>
                <th>Người tạo</th>
                <th>Tổng số tiền</th>
                <th>Doanh thu sau chiết khấu</th>
                @if (ViewBag.Type <= 2)
                {
                    <th>Hoa hồng đại lý C1</th>
                }
                <th>Phí đua giá</th>
                <th>Số giao dịch</th>
                <th>Thành công</th>

                <th>Thất bại</th>
                <th>Đợi xử lý</th>
                <th>Đợi nạp</th>
                <th>Đã hủy</th>
                <th>Ngày tạo</th>
                <th>Ngày cập nhật</th>
                <th>Trạng thái</th>

                <th class="noExl">Tác vụ</th>

            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {

                <tr id="tr_@obj.OrderNo">

                    
                    <td><a href="@Url.Action("Detail", new { OrderNo = obj.OrderNo })">@obj.OrderNo</a></td>
                    <td>@obj.UserName</td>

                    <td>@StringUtils.InsertCommaNoStyle(obj.TotalAmountSuccess.ToString())/@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
                    <td>@StringUtils.InsertCommaNoStyle(obj.TotalMoney.ToString())</td>
                    @if (ViewBag.Type <= 2)
                    {
                        <td>@StringUtils.InsertCommaNoStyle(obj.TotalMoneyReward.ToString())</td>
                    }

                    <td>@StringUtils.InsertCommaNoStyle(obj.TotalMoneyPriority.ToString())</td>
                    <td>@obj.TotalTrans</td>
                    <td>@obj.TotalSuccess</td>

                    <td>@obj.TotalFail</td>
                    <td>@obj.TotalWaiting</td>
                    <td>@obj.TotalQueue</td>

                    <td>@obj.TotalCancel</td>
                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.CreatedDate)</td>
                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.UpdateDate)</td>
                    <td class="noExl" style="text-align:right">
                        @if (obj.TotalConfirm == obj.TotalTrans)
                        {
                            <text>Đã chốt</text>
                        }
                        else
                        {
                            <text>Chưa chốt</text>
                        }
                    </td>

                    <td>
                        @if (ViewBag.IsFullControl)
                        {
                            if (obj.TotalConfirm != obj.TotalTrans)
                            {
                                <span class="label label-success">
                                    <a onclick="ConfirmOrder('@obj.OrderNo')" href="javascript:;">Chốt</a>
                                </span>
                                if (obj.TotalWaiting > 0)
                                {
                                    <span class="label label-info">
                                        <a onclick="Lock('@obj.OrderNo')" href="javascript:;">Xử lý</a>
                                    </span>
                                }

                            }

                        }
                        @if (obj.UserName == ViewBag.Username && obj.TotalConfirm != obj.TotalTrans && obj.TotalWaiting > 0)
                        {
                            <span class="label label-danger">
                                <a onclick="Reset('@obj.OrderNo')" href="javascript:;">Hủy</a>
                            </span>
                        }
                    </td>
                    
                </tr>
            }



        }
    </table>
}
<script>
    function Lock(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn xử lý đơn  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Topup/LockOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function Reset(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn hủy đơn  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Topup/ResetOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function GetList(currentPage) {
        parameters = {
            telco: $('#ddlTelco').val(),
            keyword: $("#txtEmail").val(),
            userId: $("#ddlUser").val(),
            top: $("#ddlTop").val(),

        };
        var urlRequestAns = "/Topup/ListOrder";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: parameters,
            success: function (data) {
                Utils.UnLoading();
                $("#ListOrderActive").html(data);

            },
            error: function () {

            }
        });
    };

    function ConfirmOrder(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chốt  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Topup/ConfirmOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            //setTimeout(function () {
                            // Utils.UnLoading();
                            //  location.reload();

                            //}, 5000);
                            Utils.UnLoading();
                            location.reload();

                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                swal.close();
                setTimeout(function () { GetList(1);; }, 5000);

            });
    }
</script>
<style>
    .input-sm {
        width: 68%;
        float: right;
    }

    .dataTables_wrapper .row {
        margin-left: 0;
        margin-right: 0;
    }

    .dataTables_wrapper .col-sm-12, .dataTables_wrapper .col-sm-12 {
        padding-left: 0;
        padding-right: 0;
    }
</style>
