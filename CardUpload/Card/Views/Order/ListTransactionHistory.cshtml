@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<OrderDetail>

<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon"></span>Log giao dịch </div>
            <div class="box-body">

                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListTransaction">
                            @if (Model != null && Model.Count > 0)
                            {

                                <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                    <thead>
                                        <tr class="rowsao">
                                            <th>ID</th>
                                            <th>TransID</th>
                                            <th>Mã đơn</th>
                                            <th>Mobile</th>

                                            <th>Loại</th>
                                            <th>AmountSuccess</th>
                                            <th class="admountHiden">Amount User</th>
                                            <th>CardSerial</th>
                                            <th>CardCode</th>

                                            <th>Ngày tạo</th>
                                            <th>Ngày sửa</th>
                                            <th>Trạng thái</th>

                                        </tr>
                                    </thead>
                                    @if (Model.Count > 0)
                                    {
                                        foreach (var obj in Model)
                                        {
                                    <tr>
                                        <td>@obj.Id</td>
                                        <td>@obj.TransactionID</td>
                                        <td>@obj.OrderNo</td>

                                        <td>@obj.Mobile</td>

                                        <td>@HtmlHelpers.GetTelcoName(obj.Telco.ToUpper())-@HtmlHelpers.GetTopupType(obj.TopupType,obj.Telco.ToUpper())</td>

                                        <td>@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                                        <td class="admountHiden">@StringUtils.InsertCommaNoStyle(obj.AmountUser.ToString())</td>
                                        <td>@obj.CardSerial</td>
                                        <td>@obj.CardCode</td>

                                        <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.CreateTime)</td>
                                        <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LastTime)</td>
                                        <td>@obj.Status</td>
                                    </tr>
                                        }
                                    }
                                </table>
                            }

                        </div>

                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style type="text/css">
    .modal-dialog {
        width: 90% !important;
        height: 90% !important;
    }
    .admountHiden
    {
        display:none;
    }
</style>






