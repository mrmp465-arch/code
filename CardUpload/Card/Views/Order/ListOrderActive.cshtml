@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<OrderGroup>

@if (Model != null && Model.Count > 0)
{
    <div class="pull-right">
        Tổng tiền:
        @if (Model.Sum(x => x.TotalAmountSuccess) > Model.Sum(x => x.TotalAmount))
        {
            <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString()) (0)</b>
        }
        else
        {
            <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmountSuccess).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString()) (@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount - x.TotalAmountSuccess).ToString()))</b>
        }
    </div>
    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>
            <tr class="rowsao">
                <th>STT</th>

                <th>OrderNo</th>
                <th>Người tạo</th>

                <th>Telco</th>


                <th>Amount/Total</th>

                <th>Ngày cập nhật</th>

                <th class="noExl">Tác vụ</th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {

                <tr id="tr_@obj.OrderNo">
                    <td></td>

                    <td><a href="@Url.Action("TransactionOrder", new { OrderNo = obj.OrderNo, confirm = 0 })">@obj.OrderNo</a></td>
                    <td>@obj.SubUser</td>

                    <td>@HtmlHelpers.GetTelcoName(obj.Telco.ToUpper())</td>


                    @if (obj.TotalAmountSuccess > obj.TotalAmount)
                    {
                        <td> @StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString()) /@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
                    }
                    else
                    {
                        <td> @StringUtils.InsertCommaNoStyle(obj.TotalAmountSuccess.ToString()) /@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
                    }


                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LastTime)</td>
                    <td class="noExl" style="text-align:right">
                        @if ((obj.Telco.ToUpper() == "ZING" || obj.Telco.ToUpper() == "GARENA"))
                        {

                            if (ViewBag.UserType <= 2)
                            {

                                <select class="form-control1" id="ddlP_@obj.OrderNo" onchange="UpdateP('@obj.OrderNo')">
                                    <option value="99">
                                        Độ ưu tiên
                                    </option>
                                    @for (int i = 1; i <= 9; i++)
                                    {
                                        <option value="@(i+40)">
                                            P@(i)
                                        </option>
                                    }
                                </select>
                            }

                        }

                        @if (obj.OrderNo.Contains(ViewBag.Config) && ViewBag.Username == obj.SubUser)
                        {
                            <span class="label label-warning">
                                <a onclick="BidTran('@obj.OrderNo')" href="javascript:;">Đua giá</a>
                            </span>
                        }
                        @if (obj.OrderNo.Contains(ViewBag.Config) && ViewBag.Username == obj.SubUser)
                        {
                            <span class="label label-success">
                                <a onclick="Add('@obj.OrderNo','@obj.Telco.ToUpper()')" href="javascript:;">Thêm</a>
                            </span>
                        }
                        @if (obj.OrderNo.Contains(ViewBag.Config) || ViewBag.UserType <= 2)
                        {
                            <span class="label label-danger">
                                <a onclick="Lock('@obj.OrderNo')" href="javascript:;">Dừng nạp</a>
                            </span>
                            <span class="label label-info">
                                <a onclick="Reset('@obj.OrderNo')" href="javascript:;">Mở</a>

                            </span>
                            if (ViewBag.UserType == 1)
                            {<span class="label label-info">
                                    <a onclick="ResetAdmin('@obj.OrderNo')" href="javascript:;">Mở khóa</a>
                                </span>
                            }
                        }
                        @if (obj.OrderNo.Contains(ViewBag.Config) || ViewBag.UserType <= 2)
                        {

                            <span class="label label-success">
                                <a onclick="ConfirmOrder('@obj.OrderNo')" href="javascript:;">Chốt</a>
                            </span>
                        }

                        <span class="label label-info"><a target="_blank" href='@Url.Action("ReportTransactionOrder",new {orderNo=obj.OrderNo,confirm=0  })'>Excel</a> </span>

                </tr>
            }



        }
    </table>
}
<script>
    function Add(id, telco) {
        var url = "/Home/AddOrder/?Order=" + id + "&Telco=" + telco;
        var confirmFunc = null;
        Utils.PopupManager(url, confirmFunc);
    }
    function BidTran(id) {
        var url = "/Home/OrderBidMulti/?Order=" + id;
        var confirmFunc = null;
        Utils.PopupManager(url, confirmFunc);
    }
    function GetList(currentPage) {
        parameters = {
            telco: $('#ddlTelco').val(),
            keyword: $("#txtEmail").val(),
            userId: $("#ddlUser").val(),
            top: $("#ddlTop").val(),

        };
        var urlRequestAns = "/Order/ListOrderActive";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: parameters,
            success: function (data) {
                Utils.UnLoading();
                $("#ListOrderActive").html(data);

            },
            error: function () {

            }
        });
    };
    function Lock(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn tạm dừng  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/LockOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function Reset(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn mở nạp  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ResetOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function ResetAdmin(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn mở khóa  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ResetOrderAdmin",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            location.reload();
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function ConfirmOrder(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chốt  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ConfirmOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            //setTimeout(function () {
                            // Utils.UnLoading();
                            //  location.reload();

                            //}, 5000);
                            Utils.UnLoading();
                            $('#tr_' + OrderNo).hide();

                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                swal.close();
                setTimeout(function () { GetList(1);; }, 5000);

            });
    }
</script>
<style>
    .input-sm {
        width: 68%;
        float: right;
    }

    .dataTables_wrapper .row {
        margin-left: 0;
        margin-right: 0;
    }

    .dataTables_wrapper .col-sm-12, .dataTables_wrapper .col-sm-12 {
        padding-left: 0;
        padding-right: 0;
    }
</style>
<script>
    $(document).ready(function () {

        var tabv = $('#dataTables').DataTable(
            {
                "bPaginate": false,
                "paging": false,
                "bInfo": false,
                "scrollX": false,
                "ordering": false,
                "language": {
                    "search": "Tìm kiếm",
                    "zeroRecords": "Không tìm thấy kết quả"
                },

                "columns": [
                    { "searchable": false },
                    { "searchable": true },
                    { "searchable": false },
                    { "searchable": false },
                    { "searchable": false },
                    { "searchable": false },
                    { "searchable": false },
                ],

            }
        );

        tabv.on('order.dt search.dt', function () {
            tabv.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();
        setTimeout(function () {

            $("#search_input").html("");
            $("#dataTables_filter").appendTo("#search_input");

        }, 100);

    });
</script>