@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<OrderGroup>
@if (Model != null && Model.Count > 0)
{
    <div class="pull-right">
        Tổng tiền: 
        @if (Model.Sum(x => x.TotalAmountSuccess) > Model.Sum(x => x.TotalAmount))
        {
            <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())</b>
        }
        else
        {
            <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmountSuccess).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())</b>
        }
    </div>
    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>
            <tr class="rowsao">
                <th>STT</th>

                <th>OrderNo</th>
                <th>Người tạo</th>

                <th>Telco</th>


                <th>Amount/Total</th>

                <th>Ngày cập nhật</th>
                <th>Tác vụ</th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {
    <tr>
        <td> </td>

        <td><a href="@Url.Action("TransactionOrder", new { OrderNo = obj.OrderNo,confirm=1  })">@obj.OrderNo</a></td>
        <td>@obj.SubUser</td>

        <td>@HtmlHelpers.GetTelcoName(obj.Telco.ToUpper())</td>


        @if (obj.TotalAmountSuccess > obj.TotalAmount)
        {
            <td> @StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString()) /@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
        }
        else
        {
            <td> @StringUtils.InsertCommaNoStyle(obj.TotalAmountSuccess.ToString()) /@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
        }

        <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LastTime)</td>
        <td> <a target="_blank" href='@Url.Action("ReportTransactionOrder",new {orderNo=obj.OrderNo,confirm=1  })'>Excel</a></td>

    </tr>
            }
            @*<tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    @if (Model.Sum(x => x.TotalAmountSuccess) > Model.Sum(x => x.TotalAmount))
                    {
                        <td ><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())</b></td>
                    }
                    else
                    {
                        <td ><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmountSuccess).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString())</b></td>
                    }

                </tr>*@
        }
    </table>
}
<style>
    .input-sm {
        width: 68%;
        float: right;
    }
    .dataTables_wrapper .row{
    margin-left:0;
    margin-right:0;
}
.dataTables_wrapper .col-sm-12, .dataTables_wrapper .col-sm-12 {
    padding-left: 0;
    padding-right: 0;
}
</style>
<script>
    $(document).ready(function () {

        var tabv = $('#dataTables').DataTable(
            {
                "bPaginate": false,
                "paging": false,
                "bInfo": false,
                "scrollX": false,

                "language": {
                    "search": "Tìm kiếm",
                    "zeroRecords": "Không tìm thấy kết quả"
                },
                "ordering": false,
                "columns": [
                    { "searchable": false },
                    { "searchable": true },
                    { "searchable": false },
                    { "searchable": false },
                    { "searchable": false },
                    { "searchable": false },
                     { "searchable": false },
                ],

            }
        );

        tabv.on('order.dt search.dt', function () {
            tabv.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

          setTimeout(function () {
            
                 $("#search_input").html("");
                $("#dataTables_filter").appendTo("#search_input");
                 
        }, 100);
    });
</script>