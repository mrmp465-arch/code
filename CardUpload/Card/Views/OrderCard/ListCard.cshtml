                "paging": false,
                "bInfo": false,
                "scrollX": false,
                "searching": true,
                "language": {
                    "search": "Tìm kiếm",
                    "zeroRecords": "Không tìm thấy kết quả"
                },
                "ordering": false,
                "columns": [
                    { "searchable": false },
                    { "searchable": false },
                    { "searchable": true },
                    { "searchable": true },
                    { "searchable": false },
                    { "searchable": false },
                    
                ],

            }
        );

