@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<Card.Data.DTO.CardOrderGroup>

@if (Model != null && Model.Count > 0)
{
    <div class="pull-right">
       
        Tổng thẻ (chưa dùng/tổng):<b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalQueue).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalTrans).ToString()) </b>
        &nbsp;
        Tổng tiền:
        <b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmountSuccess).ToString())/@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalAmount).ToString()) </b>
    
    
    </div>
    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables2">
        <thead>
            <tr class="rowsao">


                <th>Mã đơn</th>
                <th>Nhà mạng</th>
                <th>Tổng số tiền</th>
               
                <th>Số thẻ</th>
                <th>Đã dùng</th>
                <th>Chưa dùng</th>
                @*<th>Thất bại</th>*@
                <th>Ngày tạo</th>
                <th>Ngày cập nhật</th>
                
                <th></th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {

                <tr id="tr_@obj.OrderNo">


                    <td>@obj.OrderNo</td>
                    <td>@obj.OrderNo.Split('_')[0]</td>
                    
                    <td>@StringUtils.InsertCommaNoStyle(obj.TotalAmountSuccess.ToString())/@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
                    
                    
                    <td>@obj.TotalTrans</td>
                    <td>@obj.TotalSuccess</td>
                    <td>@obj.TotalQueue</td>
                    @*<td>@obj.TotalFail</td>*@
                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.CreatedDate)</td>
                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.UpdateDate)</td>
                    <td><a onclick="ListCard('@obj.OrderNo')" href="javascript:;">Xem</a>&nbsp;|&nbsp;<a href="@Url.Action("Download",new {orderNo=obj.OrderNo })">Download</a></td>
                    
                </tr>
            }



        }
    </table>
}
<script>
    function ListCard(OrderNo) {
        var url = "/OrderCard/ListCard/?OrderNo=" + OrderNo;
        var confirmFunc = "";
        Utils.PopupManager(url, confirmFunc);
    }
    function GetList(currentPage) {
        parameters = {
            telco: $('#ddlTelco').val(),
            keyword: $("#txtEmail").val(),
            telco: $("#ddlUser").val(),
            top: $("#ddlTop").val(),

        };
        var urlRequestAns = "/OrderCard/ListOrder";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: parameters,
            success: function (data) {
                Utils.UnLoading();
                $("#ListOrderActive").html(data);

            },
            error: function () {

            }
        });
    };

    function ConfirmOrder(OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chốt  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/OrderCard/ConfirmOrder",
                    data: addAntiForgeryToken({ order: OrderNo }),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            //setTimeout(function () {
                            // Utils.UnLoading();
                            //  location.reload();

                            //}, 5000);
                            Utils.UnLoading();
                            location.reload();

                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                swal.close();
                setTimeout(function () { GetList(1);; }, 5000);

            });
    }
</script>
<style>
    .input-sm {
        width: 68%;
        float: right;
    }

    .dataTables_wrapper .row {
        margin-left: 0;
        margin-right: 0;
    }

    .dataTables_wrapper .col-sm-12, .dataTables_wrapper .col-sm-12 {
        padding-left: 0;
        padding-right: 0;
    }
</style>
