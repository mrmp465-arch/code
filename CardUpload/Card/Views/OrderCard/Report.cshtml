@using Card.Data.DTO
@{
    List<Users> ListUser = ViewBag.UserList;

}

<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">
                <span class="glyphicon glyphicon-user"></span>
                @ViewBag.Title
            </div>
            <div class="box-body">
                
                <div class="col-md-12">
                    <div class="table-responsive">
                        <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                            <div id="ListReport">

                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        
        $("#btnSearch").click(function () {
            GetList(1);
        });

        function GetList(currentPage) {
            parameters = {

               
                
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {

            var urlRequestAns = "/OrderCard/ListReport";
            Utils.Loading();
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    Utils.UnLoading();
                    $("#ListReport").html(data);

                },
                error: function () {

                }
            });
        }
        GetList(1);

    });


</script>
