@using Card.Data.DTO
@model List<Groups>

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th> ID</th>
            <th>Name</th>
            <th>Quản trị</th>
            
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            <tr>
                <td>@obj.GroupID</td>
                <td>@obj.Name</td>
                <td>
                    @if (ViewBag.IsUpdate)
                    {
                        <a href="@Url.Action("GetGroupInfo", new { id = obj.GroupID })"><i class="fa fa-edit"></i></a>
                    }
                    
                </td>
            </tr>
        }
    }
</table>



