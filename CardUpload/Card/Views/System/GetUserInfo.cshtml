                    'PercentVTTTS': $('#ddlPercentVTTTS').length ? $("#ddlPercentVTTTS").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVTTMY': $('#ddlPercentVTTMY').length ? $("#ddlPercentVTTMY").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVNPTT': $('#ddlPercentVNPTT').length ? $("#ddlPercentVNPTT").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVNPTS': $('#ddlPercentVNPTS').length ? $("#ddlPercentVNPTS").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVNPMY': $('#ddlPercentVNPMY').length ? $("#ddlPercentVNPMY").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVMSMY': $('#ddlPercentVMSMY').length ? $("#ddlPercentVMSMY").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVMSNH': $('#ddlPercentVMSNH').length ? $("#ddlPercentVMSNH").val() : $("#ddlPercentVTTTT").val(),
                    'PercentVNMNH': $('#ddlPercentVNMNH').length ? $("#ddlPercentVNMNH").val() : $("#ddlPercentVTTTT").val(),
                    'Piority': $("#ddlPiority").val(),
                    'Password': $("#txtpassword").val(),
                    'Status': $("#cbxIsActive").is(":checked") ? true : false,
                    'StatusOrder': $("#cbxIsOrder").is(":checked") ? true : false,

                    'PasswordAPI': $("#txtPasswordAPI").val(),
                    'UserAPI': $("#txtUserAPI").val(),
                    'MaxDay': $("#txtMaxDay").val(),
                }
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("SaveDataUser")",
                    data: addAntiForgeryToken(param),
                    async: true,
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            $(".alert-success").show("slow");
                            $(".alert-danger").hide("slow");
                            setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 2000);
                        }
                        else {

                            $("#ErrorMessage").text(data.Description);
                            $(".alert-danger").show("slow");
                            $(".alert-success").hide("slow");
                            setTimeout(function () { $(".alert-danger").hide("slow"); }, 5000);
                        }
                    }
                });
            };
        });

