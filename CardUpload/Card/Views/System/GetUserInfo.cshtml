            //Save Data
            function SaveData() {
                var param = {
                    'UserID': '@Model.UserID',
                    'Username': $("#txtUserName").val(),
                    'FullName': $("#txtFullName").val(),
                    'Config': $("#txtConfig").val(),
                    'NumberUser': $("#txtNumberUser").val() == undefined ? 0 : $("#txtNumberUser").val(),
                    'Email': $("#txtEmail").val(),
                    'Password': $("#txtpassword").val(),
                    'Password2': $("#txtpassword2").val(),
                    'Type': $("#ddlType").val(),
                    'Group': $("#ddlGroup").val(),
                    'PercentVTT': $("#ddlPercentVTT").val(),
                    'PercentVNP': $('#ddlPercentVNP').length ? $("#ddlPercentVNP").val() : $("#ddlPercentVTT").val(),
                    'PercentVMS': $('#ddlPercentVMS').length ? $("#ddlPercentVMS").val() : $("#ddlPercentVTT").val(),
                    'PercentGarena': $('#ddlPercentGarena').length ? $("#ddlPercentGarena").val() : $("#ddlPercentVTT").val(),
