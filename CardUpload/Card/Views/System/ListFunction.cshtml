@using Card.Data.DTO;
@model List<Functions>

@if (Model != null && Model.Count > 0)
{
    var fathers = Model.FindAll(fa => fa.FatherID == 0);
    fathers.Sort((f1, f2) => f1.Order.CompareTo(f2.Order));
    if (fathers != null && fathers.Count > 0)
    {
        foreach (var far in fathers)
        {
            var listChirl = Model.FindAll(f => f.FatherID == far.FunctionID);
            listChirl.Sort((f1, f2) => f1.Order.CompareTo(f2.Order));
            <div class="box box-default">
                <div class="box-header with-border" id="heading_@far.FunctionID">
                    <h3 class="panel-title">
                        <i class="@far.IconId" style="margin-right:7px"></i>@far.FunctionName
                    </h3>
                    <div class="box-tools pull-right">
                        @if (ViewBag.IsUpdate)
                        {
                            <a href="@Url.Action("GetFunctionInfo", new { id = far.FunctionID })" class="btn link-edit" title="Edit" ><i class="fa fa-edit"></i></a>
                        }
                        @if (ViewBag.IsDelete)
                        {
                            <a href="javascript:;" class="btn link-delete" title="Delete" onclick="DeleteData(@far.FunctionID)"><i class="fa fa-trash-o"></i></a>
                        }
                    </div>

                </div>
                <div class="box-body">
                    @if (listChirl != null && listChirl.Count > 0)
                    {
                        var i = 1;
                        <div id="step_@far.FunctionID" class="panel-collapse collapse table-responsive in" role="tabpanel" aria-labelledby="heading_@far.FunctionID">
                            <div class="panel-body" style="margin-left: 3%">
                                <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                    <thead>
                                        <tr class="rowsao">
                                            <th width="5%">TT</th>
                                            <th width="20%">FunctionName</th>
                                            <th width="40%">Url</th>
                                            <th width="10%">Active</th>
                                            <th width="10%">Display</th>
                                            @if (ViewBag.IsUpdate || ViewBag.IsFullControl || ViewBag.IsDelete)
                                            {
                                                <th width="15%">Action</th>
                                            }
                                        </tr>
                                    </thead>
                                    @foreach (var obj in listChirl)
                                    {
                                        var listChirl2 = Model.FindAll(f => f.FatherID == obj.FunctionID);


                                        <tr>
                                            <td>@i</td>
                                            <td style="text-align: left"><i class="fa fa-fw mid_@obj.IconId"></i>@obj.FunctionName</td>
                                            <td>@obj.Url</td>
                                            <td>
                                                @if (obj.IsActive == true)
                                                {
                                                    <input type="checkbox" checked="checked" disabled />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" disabled />
                                                }
                                            </td>
                                            <td>
                                                @if (obj.IsDisplay == true)
                                                {
                                                    <input type="checkbox" checked="checked" disabled />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" disabled />
                                                }
                                            </td>
                                            @if (ViewBag.IsUpdate || ViewBag.IsFullControl || ViewBag.IsDelete)
                                            {
                                                <td style="text-align: center">
                                                    @if (ViewBag.IsUpdate)
                                                    {
                                                        <a href="@Url.Action("GetFunctionInfo", new { id = obj.FunctionID })" title="Edit"><i class="fa fa-edit"></i></a>
                                                    }
                                                    @if (ViewBag.IsDelete)
                                                    {
                                                        <a href="javascript:;" title="Delete" onclick="DeleteData(@obj.FunctionID)"><i class="fa fa-trash-o"></i></a>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                        i++;
                                    }
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    <script type="text/javascript">

        var PageOnSize = '@ViewBag.PageSize';
        var CurrentPage = '@ViewBag.CurrentPage';
        function BindDataRequest(currentPage) {
                    var params = {
                        functionName: $("#txtFunctionName").val(),
                        isActive: $('#ddlActive').val(),
                        currentPage: currentPage,
                        PageSize: PageOnSize
                    };
                    params.currentPage = currentPage;
                      var urlRequestAns = "@Url.Action("ListFunction")";
                    Utils.Loading();
                    $.ajax({
                        type: 'GET',
                        url: urlRequestAns,
                        data: params,
                        success: function (data) {
                            $("#FunctionPartial").html(data);
                            Utils.UnLoading();
                        },
                        error: function () {
                            Utils.UnLoading();
                        }
                    });
        }
        $(document).ready(function () {

                $("#pager").pager({
                    pagenumber: CurrentPage,
                    //pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
                    pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
                    buttonClickCallback: function (page) { BindDataRequest(page); }
                });


        });
        function DeleteData(id) {
            var IsDelete = "true";
            if (IsDelete != "true") {
                bootbox.alert("Bạn không có quyền xóa chức năng");
                return;
            }
            bootbox.confirm("Bạn Chắc Chắn Muốn Xóa Chức Năng Này ??? ", function (result) {
                if (result == true) {
                    Utils.Loading();
                    $.ajax({
                        type: 'POST',
                        url:  "@Url.Action("DeleteFunction")",
                        data: addAntiForgeryToken({ id: id }),
                        success: function (data) {
                            Utils.UnLoading();
                            if (data.ResponseCode >= 0) {
                                bootbox.alert(data.Description);
                                BindDataRequest(CurrentPage)
                            }
                            else {
                                bootbox.alert(data.Description);
                                return;
                            }
                        }
                    });
                }
            });
        }
    </script>
}
