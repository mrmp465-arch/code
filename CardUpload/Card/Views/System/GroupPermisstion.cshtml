
@{
    ViewBag.Title = "Danh sách nhóm quyền";
}
@using Card.Data.DTO
@model List<Groups>


<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><i class="fa fa-wrench"></i>Danh Sách Nhóm</div>
            <div class="box-body">

                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="FunctionPartial">
                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                            <thead>
                                <tr class="rowsao">
                                    <th> ID</th>
                                    <th>Name</th>
                                    <th>Quản trị</th>

                                </tr>
                            </thead>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var obj in Model)
                                {
                                    <tr>
                                        <td>@obj.GroupID</td>
                                        <td>@obj.Name</td>
                                        <td>
                                            
                                            @if (ViewBag.IsFullControl)
                                            {
                                                if (obj.GroupID != 1)
                                                {
                                                    <a href="@Url.Action("GetGrantGroup", new { id = obj.GroupID })" title="Grant"><i class="fa fa-cogs"></i></a>
                                                }

                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </table>
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
