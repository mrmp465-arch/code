@using Card.Data.DTO
@model List<Transactions>
@using Card.Utility
@using Card.CMS.Helper
@{ var idx = 0; }
    @*<div class="pull-right">
        Tổng tiền vào: <b class="blue_txt"> @StringUtils.InsertCommaNoStyle(ViewBag.TotalTopup.ToString())</b> &nbsp; &nbsp;

        Tổng tiền ra: <b class="red_txt"> @StringUtils.InsertCommaNoStyle(ViewBag.TotalDeduct.ToString())</b>



    </div>*@
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>STT</th>

            <th>Số tiền</th>
            <th>Số dư sau giao dịch</th>
            <th>Mô tả</th>
            <th>Thời gian</th>
            @*<th >ClientIP</th>*@
        </tr>
    </thead>
    @if (Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
            <tr>

                <td style="text-align:left;">@(idx + (ViewBag.CurrentPage - 1) * ViewBag.PageSize)</td>

                <td style="text-align:left;">@Html.Raw(StringUtils.InsertCommaMark(obj.Amount.ToString(), obj.Type))</td>
                <td style="text-align:left;">@StringUtils.InsertCommaNoStyle(obj.Balance.ToString()) </td>
                <td style="text-align:left;">@obj.Description - @obj.Note</td>
                <td>@string.Format("{0:dd/MM/yyyy HH:mm:ss}", obj.Time)</td>
                @*<td>@obj.ClientIP</td>*@
            </tr>

        }
    }
</table>
<script type="text/javascript">
        var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
     $(document).ready(function () {

         $("#pager2").pager({
            pagenumber: CurrentPage,
           pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest2(page); }
        });


    });
    function BindDataRequest2(currentPage) {
                var params = {
                   ActionType: $('#ddlActionType').val(),
                    'username': '@ViewBag.username',
                    'keyword': $("#txtKeyword").val(),
                    'FromDate': $("#fromDate").val(),
                    'ToDate': $("#toDate").val(),
                    'currentPage': currentPage,
                    'pageSize': 15
                };
                params.currentPage = currentPage;
                var urlRequestAns = "@Url.Action("ListTransaction")";
                Utils.Loading();
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: params,
                    success: function (data) {
                        $("#ListTransaction").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            };
</script>