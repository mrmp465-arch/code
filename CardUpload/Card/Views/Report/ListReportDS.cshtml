@using Card.CMS.Models
@using Card.CMS.Helper
@using Card.Utility
@model List<Card.Data.Api.OrderReportHistoryDS>
@if (ViewBag.userId > 0)
{
    <div class="table-responsive">
        <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
            @if (Model != null && Model.Count > 0)
            {

                <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                    <thead>
                        <tr class="rowsao">
                            <th>Ngày</th>
                            <th>VTT(không my)</th>
                            <th>MYVTT-FTTH</th>

                            <th>VNP</th>
                            <th>VMS</th>
                            <th>Zing</th>
                            <th>Garena</th>
                            <th>Đua giá</th>
                        </tr>
                    </thead>
                    @if (Model.Count > 0)
                    {
                        foreach (var obj in Model)
                        {
                            <tr>
                                <td>@obj.Data</td>
                                <td>
                                    @StringUtils.InsertCommaNoStyle(obj.TotalVTT.ToString())
                                </td>
                                <td>
                                    @StringUtils.InsertCommaNoStyle(obj.TotalMyVTT.ToString())
                                </td>
                                <td>
                                    @StringUtils.InsertCommaNoStyle(obj.TotalVNP.ToString())
                                </td>
                                <td>
                                    @StringUtils.InsertCommaNoStyle(obj.TotalVMS.ToString())
                                </td>
                                <td>
                                    @StringUtils.InsertCommaNoStyle(obj.TotalZing.ToString())
                                </td>
                                <td>
                                    @StringUtils.InsertCommaNoStyle(obj.TotalGarena.ToString())
                                </td>
                           
                                <td> @StringUtils.InsertCommaNoStyle(obj.TotalBidFee.ToString())</td>

                            </tr>

                        }
                        <tr>
                            <td>Tổng</td>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalVTT).ToString())</b>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalMyVTT).ToString())</b>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalVNP).ToString())</b>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalVMS).ToString())</b>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalZing).ToString())</b>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalGarena).ToString())</b>
                            <td><b>@StringUtils.InsertCommaNoStyle(Model.Sum(x => x.TotalBidFee).ToString())</b>
                        </tr>
                    }
                </table>
            }
        </div>
    </div>
    <script>
        $("#btn_export").show();
    </script>
}
<script type="text/javascript">
    $(document).ready(function () {
        $("#btn_export").click(function () {

            var urlRequestAns = "/Report/ExportDS?userId=" + $("#ddlUser").val() + "&FromDate=" + $("#fromDate").val() + "&ToDate=" + $("#toDate").val();

            window.location = urlRequestAns;

        });


    });
</script>
