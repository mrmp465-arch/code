@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<OrderReportHistory>

<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon"></span>Log giao dịch </div>
            <div class="box-body">

                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListTransaction">
                            @if (Model != null && Model.Count > 0)
                            {

                                <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                    <thead>
                                        <tr class="rowsao">
                                           
                                            <th>OrderId</th>
                                            <th>Mã đơn</th>
                                            <th>Mobile</th>

                                            <th>Loại</th>
                                            <th>AmountSuccess</th>
                                            
                                           
                                            <th>Ngày tạo</th>
                                           

                                        </tr>
                                    </thead>
                                    @if (Model.Count > 0)
                                    {
                                        foreach (var obj in Model)
                                        {
                                            <tr>
                                               
                                                <td>@obj.OrderId</td>
                                                <td>@obj.OrderNo</td>

                                                <td>@obj.Mobile</td>

                                                <td>@HtmlHelpers.GetTelcoName(obj.Telco.ToUpper())-@HtmlHelpers.GetTopupType(obj.TopupType,obj.Telco.ToUpper())</td>

                                                <td>@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                                               
                                             

                                                <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.CreatedDate)</td>
                                                
                                                
                                            </tr>
                                        }
                                    }
                                </table>
                            }

                        </div>

                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style type="text/css">
    .modal-dialog {
        width: 90% !important;
        height: 90% !important;
    }

    .admountHiden {
        display: none;
    }
</style>






