@using Card.Data.Api
@using Card.Utility
@using Card.CMS.Helper
@model List<OrderReport>
@if (Model != null && Model.Count > 0)
{

    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>
            <tr class="rowsao">

                <th>OrderNo</th>
                <th>TransID</th>

                <th>Mobile</th>

                <th>Telco</th>
                <th>Nạp 199</th>
                <th >Amount/Total</th>

                <th>Ngày tạo</th>
                <th>Tác vụ</th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {
                <tr>

                    <td>@obj.OrderNo</td>
                    <td>@obj.OrderId</td>

                    <td>@obj.Mobile</td>

                    <td >@HtmlHelpers.GetTelcoName(obj.Telco.ToUpper())-@HtmlHelpers.GetTopupType(obj.TopupType,obj.Telco.ToUpper())</td>
                    <td>@(obj.Ussd == 0 ? "Không" : "Có")</td>

                    <td > @StringUtils.InsertCommaNoStyle(obj.AmoutSuccess.ToString()) /@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>


                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.CreatedDate)</td>
                    <td>
                        @if (obj.AmoutSuccess > 0)
                        {

                            <a onclick="HistoryUser(@obj.OrderId)" href="javascript:;">Xem </a>

                        }
                    </td>
                    
                </tr>
            }

        }
    </table>
}
<script>
    function HistoryUser(id) {
        var url = "/Report/ListTransactionHistory/?transId=" + id;
        var confirmFunc = "";
        Utils.PopupManager(url, confirmFunc);
    }
</script>