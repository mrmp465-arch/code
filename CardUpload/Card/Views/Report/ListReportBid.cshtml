@using Card.CMS.Models
@using Card.CMS.Helper
@using Card.Utility
@model List<Card.Data.Api.OrderReportHistoryItem>
@{
    List<string> LstDate = ViewBag.lstCate;
    List<decimal> lstBidRate = ViewBag.lstBidRate;
}
<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null)
        {



        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
            <thead>
                <tr class="rowsao">
                    <th rowspan="2">Giờ</th>
                    <th colspan="@lstBidRate.Count">Phần trăm sản lượng (theo chiết khấu đua) </th>


                </tr>
                <tr class="rowsao">
                    @foreach (var item in lstBidRate)
                    {
                        <th>@string.Format("{0:F0}", item)</th>
                    }

                </tr>

            </thead>
            @for (int i = LstDate.Count - 1; i >= 0; i--)
            {
                var obj = LstDate[i];
                var Total = Model.Where(x => x.Data == obj).Sum(a => a.TotalAmount);
                <tr>
                    <td><b>@obj</b></td>
                    @foreach (var item in lstBidRate)
                    {
                        if (Model.Exists(x => x.Data == obj && x.BidRate == item))
                        {
                            <td>
                                @string.Format("{0:N2}", (decimal)(Model.FirstOrDefault(x => x.Data == obj && x.BidRate == item).TotalAmount * 100) / (long)Total) %

                            </td>
                        }
                        else
                        {
                            <td>0 %</td>
                        }
                    }

                </tr>

            }
            <tr>
                <td><b>Tổng</b></td>
                @foreach (var item in lstBidRate)
                {

                    <td>
                        <b>
                            @string.Format("{0:N2}", (decimal)(Model.Where(x => x.BidRate.GetValueOrDefault() == item).Sum(x => x.TotalAmount) * 100) / (long)Model.Sum(a => a.TotalAmount)) %
                        </b>
                    </td>
                }
            </tr>

        </table>

        }
    </div>
</div>
