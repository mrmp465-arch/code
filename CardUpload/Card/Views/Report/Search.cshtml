<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">
                <span class="glyphicon glyphicon-user"></span>
                @ViewBag.Title
            </div>
            <div class="box-body">
                <div class="row" id="form">

                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <label class="control-label">Mã đơn</label>
                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                            <input type="text" id="txtEmail" class="form-control" placeholder="Số điện thoại">
                        </div>
                    </div>

                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-primary">Tìm Kiếm</button>


                    </div>



                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-responsive">
                            <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                                <div id="ListOrder">

                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
      
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
       

        function GetList(currentPage) {
            parameters = {
                keyword: $("#txtEmail").val(),
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {

            var urlRequestAns = "/Report/ListOrder";
            Utils.Loading();
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    Utils.UnLoading();
                    $("#ListOrder").html(data);

                },
                error: function () {

                }
            });
        }
      

    });
</script>
