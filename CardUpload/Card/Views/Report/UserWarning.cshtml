@using Card.CMS.Models
@using Card.CMS.Helper
@using Card.Utility
@model List<Card.Data.Api.OrderGroup>
<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header">
                <span class="glyphicon glyphicon-user"></span>
                @ViewBag.Title
            </div>
            <div class="box-body">

                <div class="col-md-12">
                    <div class="table-responsive">
                        <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                            <div id="ListReport">
                                @if (Model != null && Model.Count > 0)
                                {

                                    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                        <thead>
                                            <tr class="rowsao">
                                                <th>Telco</th>
                                                <th>Time</th>


                                            </tr>
                                        </thead>
                                        @if (Model.Count > 0)
                                        {
                                            foreach (var obj in Model)
                                            {
                                                <tr>
                                                    <td>@obj.Telco</td>
                                                    <td>@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>


                                                </tr>
                                            }

                                        }
                                    </table>
                                }
                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
