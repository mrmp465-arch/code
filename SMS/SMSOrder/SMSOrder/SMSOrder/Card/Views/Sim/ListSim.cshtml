@using SMS.Data.DTO
@model List<Sims>
@using SMS.Utility
@using SMS.CMS.Helper
@{ var idx = 0; }

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th><input type="checkbox" id="chk_all" name="chk_all" onClick="toggle(this)" /></th>
            <th style="text-align:left;">STT</th>
            <th style="text-align:left;">Số điện thoại</th>
            <th style="text-align:left;">Nhóm</th>



            <th>Mạng</th>
            <th>Số dư</th>
            <th>Trạng thái</th>
            <th>Tác vụ</th>
        </tr>

    </thead>
    @if (Model != null && Model.Count > 0)
    {

        foreach (var obj in Model)
        {
            { idx++; }
            <tr>
                <td>
                    <input type="checkbox" class="chk_item" name="chk_item" value="@(Encrypt.Base64Encode(obj.Id))" />
                </td>
                <td style="text-align:left;">@(idx + (ViewBag.CurrentPage - 1) * ViewBag.PageSize)</td>
                <td style="text-align:left;">
                    <a href="javascript:;" onclick="EditSim(@obj.Id)"> @obj.Number</a>

                </td>
                <td style="text-align:left;">@HtmlHelpers.GetGroupyName(obj.Group, ViewBag.GroupList)</td>

                <td>
                    @obj.Telco
                </td>
                <td>@StringUtils.InsertCommaNoStyle((obj.Balance)).ToString()</td>
                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus('@(obj.Id)', 1);"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" class="unactive" onclick="UpdateStatus('@(obj.Id)',0);"><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td style="text-align:left">
                    @if (ViewBag.IsDelete)
                    {
                        <a href="javascript:;" title="Delete" onclick="DeleteData('@(obj.Id)')"><i class="fa fa-trash-o"></i></a><text>&nbsp;</text>
                    }
                    <a href="javascript:" title="Thêm tiền" onclick="Topup('@(obj.Number)')"><i class="fa fa-plus" aria-hidden="true"></i></a><text>&nbsp;</text>
                    <a href="javascript:" onclick="History('@(obj.Number)')" title="Lịch sử giao dịch">
                        <i class="fa fa-history" aria-hidden="true"></i>
                    </a>&nbsp;
                </td>
            </tr>
        }
    }
</table>

<script type="text/javascript">
        var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
     $(document).ready(function () {
         $("#lbtotal").html("Tổng số : @(ViewBag.TotalRecord)");
        $("#pager").pager({
            pagenumber: CurrentPage,
           pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    //$('#dataTables').DataTable({
    //    "bPaginate": false,
    //    "searching": false,
    //    "ordering": true,
    //    "info": false
    //});
</script>
<script type="text/javascript">
    function toggle(source) {
        checkboxes = document.getElementsByName('chk_item');
        for (var i = 0, n = checkboxes.length; i < n; i++) {
            checkboxes[i].checked = source.checked;
        }
    }
    function BindDataRequest(currentPage) {
        var params = {
            group: $('#ddlGroup :selected').val(),
            telco: $('#ddlTelco :selected').val(),
            status: $('#ddlActive :selected').val(),
            keyword: $("#txtEmail").val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/Sim/ListSim";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListSim").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    }
    function DeleteData(id) {

        bootbox.confirm("Bạn chắc chắn muốn xóa dữ liệu này ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Sim/Delete",
                    data: addAntiForgeryToken({ Id: id }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage)
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    function UpdateStatus(id, status) {
        var type = "Khóa";
        if (status == 0) {
            type = "Mở khóa";
        }
        bootbox.confirm("Bạn muốn " + type + " sim này này ?", function (conf) {
            if (conf == 1) {
                var urlUpstatus = "/Sim/UpdateActive";
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: urlUpstatus,
                    data: addAntiForgeryToken({ Id: id }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage)
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }
            return;
        });
    }
    function AddSim() {
        var pageurl = "/Sim/AddSimInfo/";
        $.ajax({
            type: 'GET',
            url: pageurl,
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                bootbox.dialog({
                    title: "Thêm mới sim",
                    message: data,
                    buttons: {
                        success: {
                            label: "Đóng",
                            className: "btn-success",
                            callback: function () {

                                $("#btnSearch").click();
                            }
                        }
                    }
                });
            }
        });


    }
    function EditSim(id) {
        var pageurl = "/Sim/GetSimInfo/" + id;
        $.ajax({
            type: 'GET',
            url: pageurl,
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                bootbox.dialog({
                    title: "Cập nhật danh bạ",
                    message: data,
                    buttons: {
                        success: {
                            label: "Đóng",
                            className: "btn-success",
                            callback: function () {

                                $("#btnSearch").click();
                            }
                        }
                    }
                });
            }
        });


    }
   
    function Topup(number) {
        var url = "/Sim/Topup/?number=" + number;
        var confirmFunc = BindDataRequest(1);
        Utils.PopupManager(url, confirmFunc);
    }
    function History(number) {
        var url = "/Sim/History/?number=" + number;
        var confirmFunc = BindDataRequest(1);
        Utils.PopupManager(url, confirmFunc);
    }
</script>

