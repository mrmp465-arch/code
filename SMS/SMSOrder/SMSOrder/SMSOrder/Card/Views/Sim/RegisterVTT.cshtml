@using SMS.Data.DTO
@model Contents
    <div class="row">
        <div class="col-md-6">
            <iframe width="100%" height="311px" style="border:none" src="https://smsapi.guitarpal.info/home/registervtt">
            </iframe>
        </div>
        <div class="col-md-6">
            <iframe width="100%" height="311px" style="border:none" src="https://smsapi.guitarpal.info/home/ussd">
            </iframe>

        </div>
    </div>

       
      

        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header">
                        <i class="fa fa-fw fa-user-md"></i><span>Ghi chú</span>
                    </div>
                    <form id="defaultForm" method="post" class="form-horizontal">
                        <div class="panel-group" id="steps">
                            <div class="messager-body">
                                <div class="alert alert-success display-hide alert-dismissable">
                                    <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                                    <span class="glyphicon glyphicon-ok"></span>
                                    <label>Đã lưu dữ liệu thành công !!!</label>
                                </div>
                                <div class="alert alert-danger display-hide alert-dismissable">
                                    <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                                    <span class="glyphicon glyphicon-warning-sign"></span>
                                    <label id="ErrorMessage">Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                                </div>
                            </div>
                            <div class="panel">

                                <div class="form-body">

                                    <div class="form-group">

                                        <label class="control-label col-md-4"></label>
                                        <div class="col-md-6">
                                            <div class="input-icon right">
                                                <textarea id="txtDescription" style="height: 220px;" cols="20" name="description" class="form-control">@Html.Raw(Model.Description.TrimStart().Replace("<br />","\n"))</textarea>
                                            </div>
                                        </div>
                                    </div>


                                </div>
                                <div class="panel-footer form-horizontal">
                                    <div class="form-group submit">
                                        <button type="button" onclick="SaveNote()" class="btn btn-primary" id="btnSave"><i class="fa fa-save"></i> Lưu lại</button>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script>
     function SaveNote() {
         var param = {
              'Description': $("#txtDescription").val().replace(/\n/g, '<br />'),

         };
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("SaveNote")",
                    data: param,
                    async: true,
                    success: function (data) {
                        if (data.ResponseCode >= 0) {
                            location.reload();
                        }
                        else {

                            alert(data.Description);
                        }
                    }
                });
            }
        </script>
