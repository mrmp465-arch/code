@using SMS.Data.Api
@model List<SMSInbox>
@using SMS.Utility
@using SMS.CMS.Helper
@{ var idx = 0; }

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
           
            <th style="text-align:left;">STT</th>
            <th style="text-align:left;">Port</th>
            <th style="text-align:left;">Number</th>


            <th>Nội dung</th>
            <th>Thời gian</th>
          
        </tr>

    </thead>
    @if (Model != null && Model.Count > 0)
    {

        foreach (var obj in Model)
        {
            { idx++; }
            <tr>
              
                <td style="text-align:left;">@(idx)</td>
                <td style="text-align:left;">
                    @obj.port

                </td>
                <td style="text-align:left;">@obj.number</td>

                <td style="text-align:left;min-width:200px">
                    @obj.text
                </td>
                <td style="text-align:left; width:150px;">
                    @obj.timestamp
                </td>
            </tr>
        }
    }
</table>

