<script src="https://cdnjs.cloudflare.com/ajax/libs/xls/0.7.4-a/xls.core.min.js"></script>
<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="form-horizontal">
                <div class="modal-body ng-scope">
                    <div class="form-group">
                        <label for="fileName" class="text-info ng-binding">Chọn file</label>
                        <input type="file" id="excelfile" uploader="uploader" name="fileName">

                    </div>
                    <div class="form-group">
                        Tải file mẫu tại <a href="~/Content/NapTien.xlsx" target="_blank">đây</a>

                    </div>
                    <div class="form-group">
                        <label for="groupName" class="text-info ng-binding">Mô tả:</label>
                      
                        <input type="text" id="txtGroup" placeholder="Mô tả" style="min-width:320px;" />

                    </div>
                    <div class="form-group">
                        <b>Khai báo thông tin trong file excel của bạn bên dưới:</b>
                    </div>

                    <p id="msgBox" class="wr-crf-err" style="font-size:14px"></p>
                </div>

                <div class="panel-footer form-horizontal">
                    <div class="form-group submit">
                        <button type="button" class="btn btn-primary" onclick="validateData()" id="btnSave"><i class="fa fa-save"></i> Cập nhập</button>

                        <button type="button" class="btn btn-default" id="btnBack" data-dismiss="modal"><i class="fa fa-backward"></i> Hủy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

