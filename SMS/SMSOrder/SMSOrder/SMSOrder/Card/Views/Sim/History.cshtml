@using SMS.Data.DTO
@model List<TransactionSims>
@using SMS.Utility
@using SMS.CMS.Helper
@{ var idx = 0; }
<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon"></span>Lịch sử nạp tiền @ViewBag.number </div>
            <div class="box-body">

                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListTransaction">
                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                <thead>
                                    <tr class="rowsao">
                                        <th>STT</th>

                                        <th>Số tiền</th>
                                        <th>Mô tả</th>
                                        <th>Thời gian</th>
                                        @*<th >ClientIP</th>*@
                                    </tr>
                                </thead>
                                @if (Model.Count > 0)
                                {
                                    foreach (var obj in Model)
                                    {
                                        { idx++; }
                            <tr>

                                <td style="text-align:left;">@(idx+1)</td>

                                <td style="text-align:left;">@Html.Raw(StringUtils.InsertCommaMark(obj.Amount.ToString(), obj.Type))</td>
                                <td style="text-align:left;">@obj.Description</td>

                                <td>@string.Format("{0:dd/MM/yyyy HH:mm:ss}", obj.Time)</td>
                                @*<td>@obj.ClientIP</td>*@
                            </tr>

                                    }
                                }
                            </table>
                        </div>

                        <div class="dataTables_paginate" id="pager2">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style type="text/css">
    .modal-dialog {
        width: 70% !important;
        height: 90% !important;
    }
</style>





