@using SMS.Data.DTO
@using SMS.Data.Api
@model List<NumberLock>

    <div class="row">
        <div class="col-lg-12">
            <div class="box box-primary">
                <div class="box-header">
                    <span class="glyphicon glyphicon-user"></span>
                    @ViewBag.Title
                </div>
                <div class="box-body">

                    <div class="col-md-12">
                        <div class="table-responsive">
                            <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                                <div id="ListReport">
                                    <div class="table-responsive">
                                        <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                                            @if (Model != null && Model.Count > 0)
                                            {

                                                <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                                    <thead>

                                                        <tr class="rowsao">
                                                            <th>Số đt</th>
                                                            <th>Port</th>
                                                            <th>Khóa</th>
                                                            <th>Thời gian</th>
                                                            <th>Xóa</th>
                                                        </tr>

                                                    </thead>
                                                    @foreach (var obj in Model.OrderByDescending(x=>x.lastime))
                                                    {
                                                        <tr>
                                                            <td>@obj.number</td>
                                                            <td>@obj.port</td>
                                                            <td>
                                                                @if (obj.type.GetValueOrDefault() == 1)
                                                                {
                                                                    <text>Khóa VMS</text>
                                                                }
                                                                else
                                                                {
                                                                    <text>Khóa tin nhắn</text>
                                                                }
                                                                                                                    </td>
                                                            <td>@obj.lastime.ToString("dd/MM/yyyy HH:mm")</td>
                                                            <td>
                                                                <a href="javascript:;" title="Delete" onclick="DeleteData('@obj.number', '@obj.type.GetValueOrDefault()')"><i class="fa fa-trash-o"></i></a>
                                                            </td>
                                                        </tr>
                                                    }


                                                </table>
                                            }
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<script>
    function DeleteData(number,type) {
      
        bootbox.confirm("Bạn chắc chắn muốn xóa  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Report/DeleteNumber",
                    data: addAntiForgeryToken({ number: number,type:type }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            location.reload();
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>