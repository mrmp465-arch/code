@using SMS.Data.DTO

@model List<SMSReport>
@{
    List<string> LstDate = ViewBag.lstCate;
    List<int> LstType = new List<int>() { 1, 2, 3 };
}
<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {

            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">
                        <th rowspan="2">Giờ</th>
                        <th colspan="3">Số SMS </th>
                        <th rowspan="2">Tổng</th>


                    </tr>
                    <tr class="rowsao">
                        <th>VTT</th>
                        <th>VMS</th>
                        <th>VNP</th>
                    </tr>

                </thead>
                @for (int i =  0; i < LstDate.Count; i++)
                {
                    var obj = LstDate[i];
                    <tr>
                        <td>@obj</td>
                        @foreach (var item in LstType)
                        {
                            if (Model.Exists(x => x.Data == obj && x.Telco == item))
                            {
                                <td>@Model.FirstOrDefault(x => x.Data == obj && x.Telco == item).Total </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                        <td>
                            <b>@Model.Where(x => x.Data == obj).Sum(a => a.Total)</b>
                        </td>
                    </tr>

                }
                <tr>
                    <td><b>Tổng</b></td>
                    @foreach (var item in LstType)
                    {
                        <td><b>@Model.Where(x => x.Telco == item).Sum(a => a.Total)</b> </td>
                    }
                    <td>
                        <b>@Model.Sum(a => a.Total)</b>
                    </td>
                </tr>

            </table>
        }
    </div>
</div>


<div id="container" style="min-width: 310px; height: 500px; margin: 0 auto"></div>


<script>
    var colors = ['#8aec76', '#7ab4ec', '#ED561B'];
        Highcharts.chart('container', {
            chart: {
                type: 'column'
            },
            title: {
                text: 'Báo cáo sản lượng theo giờ'
            },
            colors: colors,
            xAxis: {
                categories: @(Html.Raw(ViewBag.datacategory)),
                crosshair: true
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Amount'
                }
            },
            tooltip: {
                headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                    '<td style="padding:0"><b>{point.y} </b></td></tr>',
                footerFormat: '</table>',
                shared: true,
                useHTML: true
            },
            plotOptions: {
                column: {
                    pointPadding: 0.2,
                    borderWidth: 0
                }
            },
            series: [{
                 name: 'VTT',

                data: @Html.Raw(ViewBag.DataLine)

            },
            {
                name: 'VMS',

                data: @Html.Raw(ViewBag.DataLine2)

            },
            {
                name: 'VNP',

                data: @Html.Raw(ViewBag.DataLine3)

            }

            ]
        });
</script>