@using SMS.Data.DTO
@model List<SMSReport>
@{
    List<string> LstDate = ViewBag.lstCate;
    List<string> LstName = ViewBag.lstUserName;
}
<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {

            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">
                        <th rowspan="2">Giờ</th>
                        <th colspan="@LstName.Count">Số SMS </th>
                        <th rowspan="2">Tổng</th>


                    </tr>
                    <tr class="rowsao">
                        @foreach (var item in LstName)
                        {
                            <th>@item</th>
                        }

                    </tr>

                </thead>
                @for (int i = LstDate.Count - 1; i >= 0; i--)
                {
                    var obj = LstDate[i];
                    <tr>
                        <td>@obj</td>
                        @foreach (var item in LstName)
                        {
                            if (Model.Exists(x => x.Data == obj && x.CreatedUser == item))
                            {
                                <td>@Model.FirstOrDefault(x => x.Data == obj && x.CreatedUser == item).Total </td>
                            }
                            else
                            {
                                <td>0</td>
                            }
                        }
                        <td>
                            <b>@Model.Where(x => x.Data == obj).Sum(a => a.Total)</b>
                        </td>
                    </tr>

                }
                <tr>
                    <td><b>Tổng</b></td>
                    @foreach (var item in LstName)
                    {
                        <td><b>@Model.Where(x => x.CreatedUser == item).Sum(a => a.Total)</b> </td>
                    }
                    <td>
                        <b>@Model.Sum(a => a.Total)</b>
                    </td>
                </tr>

            </table>
        }
    </div>
</div>

<div id="container" style="min-width: 310px; height: 400px; margin: 0 auto"></div>


<script>
    Highcharts.chart('container', {
        chart: {
            plotBackgroundColor: null,
            plotBorderWidth: null,
            plotShadow: false,
            type: 'pie'
        },
        title: {
            text: 'Báo cáo sản lượng theo user'
        },
        tooltip: {
            pointFormat: '<b>{point.percentage:.1f}%</b>'
        },
        plotOptions: {
            pie: {
                allowPointSelect: true,
                cursor: 'pointer',
                dataLabels: {
                    enabled: true,
                    format: '<b>{point.name}</b>: {point.percentage:.1f} %'
                }
            }
        },
        series: [{
            name: 'Đại lý',
            colorByPoint: true,
            data: [@Html.Raw(ViewBag.DataLine)]
        }]
    });
</script>