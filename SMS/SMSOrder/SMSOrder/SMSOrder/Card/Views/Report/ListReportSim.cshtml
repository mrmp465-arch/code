@using SMS.Data.DTO
@model List<SMSReport>

<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {

            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">
                        <th>Port</th>
                        <th>Số ĐT</th>
                        <th>Số SMS</th>


                    </tr>
                   

                </thead>
                @for (int i = 0; i <=Model.Count-1; i++)
                {
                    var obj = Model[i];
                    <tr>
                        <td>@obj.CreatedUser</td>
                        <td>@obj.Data</td>
                        <td>@obj.Total</td>
                    </tr>

                }
                

            </table>
        }
    </div>
</div>

