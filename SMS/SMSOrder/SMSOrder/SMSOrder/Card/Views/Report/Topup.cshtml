

<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><i class="fa fa-building"></i>@ViewBag.Title</div>
            <div class="box-body">
                <div class="row" id="form">
                   
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" id="datetimepicker_FromDate">
                        <label class="control-label text-info"><i class="fa fa-calendar"></i> Tháng</label>
                        <div class="col-xs-4 col-md-8 col-sm-8 col-xs-12">
                            <div class="date" id="datetimeFromDate">
                                <input type="text" data-date-format="MM/YYYY" autocomplete="off" id="fromDate" class="form-control" name="datetimeFromDate" />

                            </div>
                        </div>
                    </div>

                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i> Tìm Kiếm</button>

                    </div>
                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListReport">

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">


    $(document).ready(function () {

        $('#datetimeFromDate').datetimepicker({
            locale: 'vi',
           pickTime: false,
           format: "mm-yyyy",
           viewMode: "months",
           minViewMode: "months",
                autoclose: true
            });

        var fromdate = '@string.Format("{0:MM/yyyy}", ViewBag.fromDate)';
        $('#datetimeFromDate').data("DateTimePicker").setDate(fromdate);



        GetList();
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList();
        });
       
    });



</script>
<script>

    function GetList() {

        var parameters = {

            'from': $("#fromDate").val(),
             
        };
        var urlRequestAns = '@Url.Action("ListTopup")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            data: parameters,
            url: urlRequestAns,
            success: function (data) {
                $("#ListReport").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    }
</script>