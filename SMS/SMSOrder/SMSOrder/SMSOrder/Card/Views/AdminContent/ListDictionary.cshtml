@using SMS.Data.DTO
@model List<SMSDictionary>
@using SMS.Utility
@using SMS.CMS.Helper
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">

            <th style="text-align:left;">STT</th>
            <th style="text-align:left;">Key</th>
            <th tyle="text-align:left;">Value</th>

            <th>Người tạo</th>
            <th >Chức Năng</th>
        </tr>

    </thead>
    @if (Model != null && Model.Count > 0)
    {

        foreach (var obj in Model)
        {
            { idx++; }
            <tr>

                <td style="text-align:left;">@(idx+1 )</td>
                <td style="text-align:left;">
                    @if (!ViewBag.IsAdmin && obj.CreatedUser == "admin")
                    {
                       <span>@obj.Key</span> 
                    }
                    else
                    {
                        <a href="javascript:;" onclick="EditDictionary('@obj.Id')"> @obj.Key</a>
                    }


                </td>
                <td style="text-align:left;">
                    @obj.Value
                </td>
                <td>
                    @obj.CreatedUser
                </td>
                <td>
                    @if (ViewBag.IsAdmin || obj.CreatedUser != "admin")
                    {
                        <a href="javascript:;" title="Delete" onclick="DeleteData('@(Encrypt.Base64Encode(obj.Id))')"><i class="fa fa-trash-o"></i></a><text>&nbsp;</text>
                    }

                </td>

            </tr>
        }
    }
</table>


<script>
    function DeleteData(id) {
      
        bootbox.confirm("Bạn chắc chắn muốn xóa dữ liệu ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/AdminContent/DeleteDictionary",
                    data: addAntiForgeryToken({ id: id }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            location.reload();
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>