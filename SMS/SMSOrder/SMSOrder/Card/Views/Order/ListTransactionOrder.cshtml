@using SMS.Data.Api
@using SMS.Utility
@using SMS.CMS.Helper
@model List<OrderOutput>

@if (Model != null && Model.Count > 0)
{

    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>
            <tr class="rowsao">
                <th>Trạng thái</th>
                <th>TransID</th>

                <th>Mobile</th>
                <th>Telco</th>

                <th>AmountSuccess</th>
                <th>AmountMinAll</th>
                <th>Trạng thái</th>
                <th>Ngày cập nhật</th>
                <th class="noExl">Tác vụ</th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {
                <tr>
                    <td>@Html.Raw(HtmlHelpers.GetTranStatus(obj.Status))</td>
                    <td>@obj.TransactionID</td>


                    <td>@obj.Mobile</td>

                    <td style="text-align:left">@obj.Telco.ToUpper()-@HtmlHelpers.GetTopupType(obj.TopupType)</td>

                    <td>@StringUtils.InsertCommaNoStyle(obj.AmountTopupSuccess.ToString())/@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                    <td class="noExl">
                        @if (obj.Status == 1|| obj.Status == 2)
                        {
                            if (obj.OrderNo.Contains(ViewBag.Config))
                            {
                                <select class="form-control1" id="ddlAmountMinAll" onchange="UpdateAmount('@obj.TransactionID','@obj.AmountMin','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')">

                                    <option @if (obj.AmountMinAll == 10000) { @Html.Raw("selected='selected'") ; } value="10000">
                                        10.000
                                    </option>
                                    <option @if (obj.AmountMinAll == 20000) { @Html.Raw("selected='selected'") ; } value="20000">
                                        20.000
                                    </option>
                                    <option @if (obj.AmountMinAll == 50000) { @Html.Raw("selected='selected'") ; } value="50000">
                                        50.000
                                    </option>
                                    <option @if (obj.AmountMinAll == 100000) { @Html.Raw("selected='selected'") ; } value="100000">
                                        100.000
                                    </option>
                                    <option @if (obj.AmountMinAll == 200000) { @Html.Raw("selected='selected'") ; } value="200000">
                                        200.000
                                    </option>
                                    <option @if (obj.AmountMinAll == 500000) { @Html.Raw("selected='selected'") ; } value="500000">
                                        500.000
                                    </option>

                                </select>
                            }
                            else
                            {
                                @obj.AmountMinAll
                            }

                        }
                        else
                        {
                            @obj.AmountMinAll
                        }


                    </td>
                    <td style="display:none;">
                        @obj.AmountMinAll
                    </td>
                    <td>@(obj.IsConfirm == 0 ? " Chưa chốt" : " Đã chốt")</td>

                    <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LastTime)</td>

                    <td class="noExl">
                        @if (obj.OrderNo.Contains(ViewBag.Config))
                        {
                            if (obj.Status != -2 && obj.IsConfirm != 1)
                            {
                                <a onclick="Lock('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Khóa</a>
                            }
                            if (obj.IsConfirm != 1)
                            {
                                <text>&nbsp;</text> <a onclick="ConfirmOrder('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Chốt</a>

                                if (obj.Status != 3 && obj.Status != 1 && obj.Status != 0)
                                {
                                    <text>&nbsp;</text> <a onclick="ResetTran('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Request</a>
                                }
                            }

                        }
                        @if (obj.AmountTopupSuccess > 0)
                        {
                            <text>&nbsp;</text><a onclick="HistoryUser(@obj.TransactionID)" href="javascript:;">Xem </a>
                            <text>&nbsp;</text> <a target="_blank" href='@Url.Action("ReportTransactionHistory",new {orderNo=obj.OrderNo,transId=obj.TransactionID })'>Excel</a>
                        }

                    </td>
                </tr>
            }
        }
    </table>
}

<script>
     function GetList(currentPage) {
            parameters = {
                telco: $('#ddlTelco').val(),
                orderNo: '@ViewBag.OrderNo',
                status: $("#ddlStatus").val(),
                confirm: $("#ddlConfirm").val(),
                top: $("#ddlTop").val(),

            };
         var urlRequestAns = "/Order/ListTransactionOrder";
         $.ajax({
             type: 'GET',
             url: urlRequestAns,
             data: parameters,
             success: function (data) {
                 Utils.UnLoading();
                 $("#ListTransactionOrder").html(data);

             },
             error: function () {

             }
         });
    };
    function ResetTran(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chuyển về trạng thái đợi xử lý  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ResetTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            showmess(data.Description, "success", "btn-success");
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function Lock(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn khóa telco  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/LockTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            showmess(data.Description, "success", "btn-success");
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function UpdateAmount(id, AmountMin, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn cập nhật mệnh giá thẻ nhỏ nhất ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/UpdateAmountTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: $('#ddlAmountMinAll').val(), Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            showmess(data.Description, "success", "btn-success");
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function ConfirmOrder(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chốt  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ConfirmTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            showmess(data.Description, "success", "btn-success");
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                swal.close();
                setTimeout(function () { GetList(1);; }, 5000);
               
            });
    }
    function HistoryUser(id) {
        var url = "/Order/ListTransactionHistory/?transId=" + id;
        var confirmFunc ="";
        Utils.PopupManager(url, confirmFunc);
    }
</script>