@using SMS.Data.Api
@using SMS.Utility
@using SMS.CMS.Helper
@model List<OrderGroup>
@if (Model != null && Model.Count > 0)
{

    <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
        <thead>
            <tr class="rowsao">

                <th>OrderNo</th>


                <th>Telco</th>

                <th style="text-align:left">Trans/Total</th>
                <th style="text-align:left">Amount/Total/Hold</th>
                <th>Queue</th>
                <th>Ignore</th>
                <th>Success</th>
                <th>Disable</th>
                <th>Khóa</th>
                <th>Ngày cập nhật</th>
                <th>Tác vụ</th>
            </tr>
        </thead>
        @if (Model.Count > 0)
        {
            foreach (var obj in Model)
            {
        <tr>

            <td><a href="@Url.Action("TransactionOrder", new { OrderNo = obj.OrderNo })">@obj.OrderNo</a></td>


            <td>@obj.Telco.ToUpper()</td>

            <td style="text-align:left">@obj.TotalTranSuccess / @obj.TotalTrans</td>
            <td style="text-align:left"> @StringUtils.InsertCommaNoStyle(obj.TotalAmountSuccess.ToString()) /@StringUtils.InsertCommaNoStyle(obj.TotalAmount.ToString())</td>
            <td>@obj.Queue</td>
            <td>@obj.Ignore</td>
            <td>@obj.Success</td>
            <td>@obj.Disable</td>
            <td>@obj.Lock</td>
            <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LastTime)</td>
            <td> <a target="_blank" href='@Url.Action("ReportTransactionOrder",new {orderNo=obj.OrderNo })'>Excel</a></td>

        </tr>
            }
        }
    </table>
}

