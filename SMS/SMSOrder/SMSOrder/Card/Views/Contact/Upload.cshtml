    <script>
    function validateData() {

        if (!ValidateControls("Vui lòng chọn cột chứa số điện thoại", "#columnNumber")) {
            return false;
        }

        if (!ValidateControls("Vui lòng chọn nhóm khách hàng", "#txtGroup")) {
            return false;
        }
        var Gender = $("#columnSex").val();
        if (Gender != "") {
            if (!ValidateControls("Vui lòng nhập giá trị giới tính", "#txtMale")) {
                return false;
            }
            if (!ValidateControls("Vui lòng nhập giá trị giới tính", "#txtFemale")) {
                return false;
            }

        }
        ExportToTable();
    }
    function SaveData(jsonResult)
    {
        var datatemp = "<br><br><b>Dữ liệu mẫu</b> Số điện thoại: " + jsonResult[0].Number;

        if (jsonResult[0].Name != '' && jsonResult[0].Name != undefined) {

            datatemp += "| Tên:" + jsonResult[0].Name;
        }
        if (jsonResult[0].Email != '' && jsonResult[0].Email != undefined) {

            datatemp += "| Email:" + jsonResult[0].Email;
        }
        if (jsonResult[0].Birthday != '' && jsonResult[0].Birthday != undefined) {
            datatemp += "| Ngày sinh:" + jsonResult[0].Birthday;
        }
        if (jsonResult[0].Gender != '0' && jsonResult[0].Gender != undefined) {
            datatemp += "| Giới tính:";
            datatemp += jsonResult[0].Gender == 1 ? 'Nam' : 'Nữ';
        }
        if (jsonResult[0].Option1 != '' && jsonResult[0].Option1 != undefined) {
            datatemp += "| Tùy chọn:" + jsonResult[0].Option1;
        }
        if (jsonResult[0].Option2 != '' && jsonResult[0].Option2 != undefined) {
            datatemp += "| Tùy chọn 2:" + jsonResult[0].Option2;
        }
        if (jsonResult[0].Option3 != '' && jsonResult[0].Option3 != undefined) {
            datatemp += "| Tùy chọn 3:" + jsonResult[0].Option3;
        }
        if (jsonResult[0].Option4 != '' && jsonResult[0].Option5 != undefined) {
            datatemp += "| Tùy chọn 4:" + jsonResult[0].Option4;
        }
        if (jsonResult[0].Option5 != '' && jsonResult[0].Option5 != undefined) {
            datatemp += "| Tùy chọn 5:" + jsonResult[0].Option5;
        }
        bootbox.confirm("<b>Bạn chắc chắn tạo danh bạ ???</b> " + datatemp, function (result) {
            if (!result) {
                return;
            }
             $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveMulti")",
                 data: JSON.stringify(jsonResult),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                async: true,
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {

                        $('.modal ').modal('hide');
                        if (data.Extended == 'add') {

                            $('#ddlGroup').append($('<option>', {
                                value: data.ResponseCode,
                                text: data.Description
                            }));

                        }
                        $("#ddlGroup").val(data.ResponseCode).change();
                        $("#btnSearch").click();
                    }
                    else {

                        $("#msgBox").html(data, Description).show();
                    }
                }
            });
        });

    }
    function ExportToTable() {
        var regex = /^(.*?)+(.xlsx|.xls)$/;
        /*Checks whether the file is a valid excel file*/
        if (regex.test($("#excelfile").val().toLowerCase())) {
            var xlsxflag = false; /*Flag for checking whether excel is .xls format or .xlsx format*/
            if ($("#excelfile").val().toLowerCase().indexOf(".xlsx") > 0) {
                xlsxflag = true;
            }
            /*Checks whether the browser supports HTML5*/
            if (typeof (FileReader) != "undefined") {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var data = e.target.result;
                    /*Converts the excel data in to object*/
                    if (xlsxflag) {
                        var workbook = XLSX.read(data, { type: 'binary' });
                    }
                    else {
                        var workbook = XLS.read(data, { type: 'binary' });
                    }
                    /*Gets all the sheetnames of excel in to a variable*/
                    var sheet_name_list = workbook.SheetNames;

                    var cnt = 0; /*This is used for restricting the script to consider only first sheet of excel*/
                    sheet_name_list.forEach(function (y) { /*Iterate through all sheets*/
                        /*Convert the cell value to Json*/
                        if (xlsxflag) {
                            var exceljson = XLSX.utils.sheet_to_json(workbook.Sheets[y]);
                        }
                        else {
                            var exceljson = XLS.utils.sheet_to_row_object_array(workbook.Sheets[y]);
                        }
                        if (exceljson.length > 0 && cnt == 0) {
                            var jsonResult = BindTable(exceljson);
                            SaveData(jsonResult);
                            cnt++;



                        }
                    });
                    $('#exceltable').show();
                }
                if (xlsxflag) {/*If excel file is .xlsx extension than creates a Array Buffer from excel*/
                    reader.readAsArrayBuffer($("#excelfile")[0].files[0]);
                }
                else {
                    reader.readAsBinaryString($("#excelfile")[0].files[0]);
                }
            }
            else {
                alert("Sorry! Your browser does not support HTML5!");
            }
        }
        else {
            alert("Please upload a valid Excel file!");
        }
    }

    function BindTable(jsondata) {/*Function used to convert the JSON array to Html Table*/
        var columns = BindTableHeader(jsondata); /*Gets all the column headings of Excel*/
        var jsonResult = [];
        var columnNumber = $("#columnNumber").val();
        var columnName = $("#columnName").val();
        var columnEmail = $("#columnEmail").val();
        var columnBirthDay = $("#columnBirthDay").val();
        var columnSex = $("#columnSex").val();
        var columnOption1 = $("#columnOption1").val();
        var columnOption2 = $("#columnOption2").val();
        var columnOption3 = $("#columnOption3").val();
        var columnOption4 = $("#columnOption4").val();
        var columnOption5 = $("#columnOption5").val();
        var Male = $("#txtMale").val();
        var Female = $("#txtFemale").val();


        for (var i = 0; i < jsondata.length; i++) {

            var param = {
                'Number': jsondata[i][columns[columnNumber]],
                'Name': columnName != '' ? jsondata[i][columns[columnName]]:'',
                'Email': columnEmail != '' ? jsondata[i][columns[columnEmail]] : '',
                'Birthday': columnBirthDay != '' ? jsondata[i][columns[columnBirthDay]] : '',
                'GroupName': $("#txtGroup").val(),

                'Option1': columnOption1 != '' ? jsondata[i][columns[columnOption1]] : '',
                'Option2': columnOption2 != '' ? jsondata[i][columns[columnOption2]] : '',
                'Option3': columnOption3 != '' ? jsondata[i][columns[columnOption3]] : '',
                'Option4': columnOption4 != '' ? jsondata[i][columns[columnOption4]] : '',
                'Option5': columnOption5 != '' ? jsondata[i][columns[columnOption5]] : '',
                'Gender': '0',

            };
            //alert(param.Option1);
            if (columnSex != "") {
                param.Gender = 1;
                if (jsondata[i][columns[columnSex]] === Female) {
                    param.Gender = 2;
                }
            }

            //console.log(jsondata[i][columns[columnOption1]]);
            //console.log(param);
            jsonResult.push(param);
            //var row$ = $('<tr/>');
            //for (var colIndex = 0; colIndex < columns.length; colIndex++) {
            //    var cellValue = jsondata[i][columns[colIndex]];
            //    //if (cellValue == null)
            //    //    cellValue = "";
            //    row$.append($('<td/>').html(cellValue));
            //}
            //$(tableid).append(row$);
        }
        return jsonResult;
    }
    function BindTableHeader(jsondata) {/*Function used to get all column names from JSON and bind the html table header*/
        var columnSet = [];
        //var headerTr$ = $('<tr/>');
        for (var i = 0; i < jsondata.length; i++) {
            var rowHash = jsondata[i];
            for (var key in rowHash) {
                if (rowHash.hasOwnProperty(key)) {
                    if ($.inArray(key, columnSet) == -1) {/*Adding each unique column names to a variable array*/
                        columnSet.push(key);
                        //headerTr$.append($('<th/>').html(key));
                    }
                }
            }
        }
        //$(tableid).append(headerTr$);
        return columnSet;
    }

    </script>
