@using SMS.Data.Api
@using SMS.Utility
@using SMS.CMS.Helper
@model List<OrderOutput>
<div class="table-responsive">
    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
        @if (Model != null && Model.Count > 0)
        {

            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                <thead>
                    <tr class="rowsao">
                        <th>Trạng thái</th>
                        <th>TransID</th>

                        <th>Mobile</th>
                        <th>Telco</th>
                       
                        <th>AmountSuccess</th>
                        <th>Trạng thái</th>
                        <th>Ngày cập nhật</th>
                        <th>Tác vụ</th>
                    </tr>
                </thead>
                @if (Model.Count > 0)
                {
                    foreach (var obj in Model)
                    {
                        <tr>
                            <td>@Html.Raw(HtmlHelpers.GetTranStatus(obj.Status))</td>
                            <td>@obj.TransactionID</td>


                            <td>@obj.Mobile</td>

                            <td style="text-align:left">@obj.Telco.ToUpper()-@HtmlHelpers.GetTopupType(obj.TopupType)</td>
                           
                            <td>@StringUtils.InsertCommaNoStyle(obj.AmountTopupSuccess.ToString())/@StringUtils.InsertCommaNoStyle(obj.Amount.ToString())</td>
                            
                            <td>@(obj.IsConfirm == 0 ? " Chưa chốt" : " Đã chốt")</td>
                            <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LastTime)</td>
                            <td>
                                @if (obj.Status != -2)
                                {
                                    <a onclick="Lock('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Khóa</a>
                                }
                                @if (obj.IsConfirm != 1)
                                {
                                    <text>&nbsp;</text> <a onclick="ConfirmOrder('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Chốt</a>
                                    if (obj.Status != 3 && obj.Status != 1 && obj.Status != 0)
                                    {
                                        <text>&nbsp;</text> <a onclick="ResetTran('@obj.TransactionID','@obj.AmountMin','@obj.AmountMinAll','@obj.Password','@obj.Status','@obj.Priority','@obj.IsConfirm','@obj.OrderNo')" href="javascript:;">Request</a>
                                    }
                                }
                                @if (obj.AmountTopupSuccess > 0)
                                {
                                    <text>&nbsp;</text> <a onclick="HistoryUser(@obj.TransactionID)" href="javascript:;">Xem </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </table>
        }
    </div>
</div>
<script>
    function ResetTran(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chuyển về trạng thái đợi xử lý  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ResetTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            showmess(data.Description, "success", "btn-success");
                        }
                        else {
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function Lock(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn khóa telco  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/LockTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo}),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            showmess(data.Description, "success", "btn-success");
                        }
                        else {

                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function ConfirmOrder(id, AmountMin, AmountMinAll, Password, Status, Priority, IsConfirm, OrderNo) {

        bootbox.confirm("Bạn chắc chắn muốn chốt  ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Order/ConfirmTran",
                    data: addAntiForgeryToken({ TransactionID: id, AmountMin: AmountMin, AmountMinAll: AmountMinAll, Password, Status: Status, Priority: Priority, IsConfirm: IsConfirm, OrderNo: OrderNo }),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                           
                            showmess(data.Description, "success", "btn-success");
                        }
                        else {
                           
                            showmess(data.Description, "error", "btn-danger");
                            return;
                        }
                    }
                });
            }
        });

    }
    function showmess(mess, type, ButtonClass) {
        swal({
            title: '',
            text: mess,
            type: type,
            confirmButtonClass: ButtonClass,
            closeOnConfirm: false,
            allowOutsideClick: true
        },
            function (isConfirm) {
                location.reload();
            });
    }
    function HistoryUser(id) {
        var url = "/Order/ListTransactionHistory/?transId=" + id;
        var confirmFunc = "";
        Utils.PopupManager(url, confirmFunc);
    }
    //showmess("Lỗi nhập sai OTP!", "error", "btn-danger");
    //showmess("Giao dịch thành công!", "success", "btn-success");
</script>