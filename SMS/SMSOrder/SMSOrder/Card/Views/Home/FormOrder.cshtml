                                    <input type="radio" name="rdoAmountType" class="ratio_amount" value="50000" />
                                </a>
                            </li>
                            <li class="">
                                <a href="javascript:;">
                                    100.000
                                    <input type="radio" name="rdoAmountType" class="ratio_amount" value="100000" />
                                </a>
                            </li>
                            <li class="">
                                <a href="javascript:;">
                                    200.000
                                    <input type="radio" name="rdoAmountType" class="ratio_amount" value="200000" />
                                </a>
                            </li>
                            <li class="">
                                <a href="javascript:;">
                                    500.000
                                    <input type="radio" name="rdoAmountType" class="ratio_amount" value="500000" />
                                </a>
                            </li>
                        </ul>
                        <h3>B3. Thông tin giao dịch</h3>
                        <div class="form-group">
                            <div class="col-md-10">
                                <input type="text" class="form-control" placeholder="Họ tên khách hàng(không bắt buộc)" id="txtFullname">
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-5 form-mobile">
                                <input type="text" class="form-control" placeholder="Số điện thoại (tài khoản) cần nạp" id="txtMobile">
                            </div>
                            <div class="col-md-5">
                                <input type="text" class="form-control" placeholder="Số tiền cần nạp" id="txtAmount">
