
@using SMS.Data.DTO
@model List<UsersLog>

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th class="col-lg-1">Time</th>
            <th class="col-lg-1">User</th>
            <th class="col-lg-1">FunctionCode</th>
            <th class="col-lg-3">Mô tả</th>
            @*<th class="col-lg-1">ClientIP</th>*@
        </tr>
    </thead>
    @if (Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            <tr>
                <td>@string.Format("{0:dd/MM/yyyy HH:mm}", obj.LogTime)</td>
                <td>@obj.UserName</td>
                <td>@obj.FunctionCode</td>
                <td style="text-align:left!important;">@obj.Description</td>
                @*<td>@obj.ClientIP</td>*@
            </tr>
        }
    }
</table>
<script type="text/javascript">
        $(document).ready(function () {
            var PageOnSize = '@ViewBag.PageSize';
            var CurrentPage = '@ViewBag.CurrentPage';

            $("#pager").pager({
                pagenumber: CurrentPage,
                pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
                buttonClickCallback: function (page) { BindDataRequest(page); }
            });
            function BindDataRequest(currentPage) {
                var params = {
                    'FromDate': $("#fromDate").val(),
                    'ToDate': $("#toDate").val(),
                    'UserId': $("#ddlUser").val(),
                    'keyword': $("#txtEmail").val(),
                    'currentPage': currentPage,
                    'pageSize': PageOnSize
                };
                params.currentPage = currentPage;
                var urlRequestAns = "@Url.Action("ListUserLog")";
                Utils.Loading();
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: params,
                    success: function (data) {
                        $("#ListUserLog").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            };

        });
</script>

