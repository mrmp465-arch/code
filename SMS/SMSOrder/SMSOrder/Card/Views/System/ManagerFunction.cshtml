@model SMS.Data.DTO.UserFunction
@{
    ViewBag.Title = "Danh sách chức năng";
}



<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><i class="fa fa-wrench"></i>Tìm Kiếm Danh Sách Chức Năng</div>
            <div class="box-body">
                <div class="row" id="form">
                    <div class="col-md-12">
                        <div class="form-group col-md-4 col-xs-12 col-sm-6">
                            <label class="control-label"><i class="fa fa-flag"></i>Trạng thái</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <select class="form-control" id="ddlActive">
                                    <option value="-1">Lấy tất cả</option>
                                    <option value="0">Không Hoạt Động</option>
                                    <option value="1" selected="selected">Hoạt Động</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-5 col-xs-12 col-sm-6">
                            <label for="txtFunctionName" class="control-label"><i class="fa fa-pencil"></i>Tên chức năng</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <input type="text" id="txtFunctionName" class="form-control" placeholder="Enter Name Function" value="">
                            </div>
                        </div>
                        <div class="form-group submit" style="text-align:center">
                            <button type="button" id="btnSearch" class="btn btn-primary">Tìm Kiếm</button>
                            @if (ViewBag.IsInsert)
                            {
                                <a href="@Url.Action("AddFunction")" class="btn btn-primary">Thêm</a>
                            }

                        </div>
                    </div>
                </div>
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="FunctionPartial">
                        @Html.Action("ListFunction", "System")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlActive").change(function () {
            GetList(1);
        });
        $("#btnCreate").click(function () {
            ViewDataFunction(0);
        });
        function GetList(currentPage) {
            parameters = {
                functionName: $("#txtFunctionName").val(),
                isActive: $('#ddlActive').val(),
                currentPage: 1
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns = "@Url.Action("ListFunction")";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#FunctionPartial").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    alert("error load fail !");
                    Utils.UnLoading();
                }
            });
        }

    });

</script>
