@model SMS.Data.DTO.UserFunction
@{
    ViewBag.Title = "Danh sách nhóm";
}



<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><i class="fa fa-wrench"></i>Danh Sách Nhóm</div>
            <div class="box-body">
                <div class="row" id="form">
                    <div class="col-md-12">
                       
                        <div class="form-group submit" style="text-align:center">
                            
                            @if (ViewBag.IsInsert)
                            {
                                <a href="@Url.Action("AddGroup")" class="btn btn-primary">Thêm</a>
                            }

                        </div>
                    </div>
                </div>
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="FunctionPartial">
                        @Html.Action("ListGroup", "System")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
