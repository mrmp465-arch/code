
@{
    ViewBag.Title = "Đăng ký gói cước VTT";
}
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header">
                <i class="fa fa-fw fa-user-md"></i><span>Đăng ký gói cước</span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label for="txtNumber" class="control-label col-md-2">Tổng đài :<span class="required">*</span></label>
                        <div class="col-md-8">
                            <div class="input-icon right">
                                <input type="number" id="txtNumber" maxlength="10" name="number" value="170" class="form-control" />
                            </div>
                        </div>
                       
                    </div>
                    <div class="form-group">
                        <label for="txtNumber" class="control-label col-md-2">Nội dung :<span class="required">*</span></label>
                        <div class="col-md-8">
                            <div class="input-icon right">
                                <input type="text" id="txtContent" maxlength="100" name="content" value="Huy S5" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="txtNumber" class="control-label col-md-2">Port :<span class="required">*</span></label>
                        <div class="col-md-4">
                            <div class="input-icon right" style="width:40%;float:left">
                                <input type="number" id="txtPort" maxlength="100" name="content" value="31" autocomplete="off" class="form-control" />
                            </div>
                            <div class="input-icon right" style="width:25%;float:left;margin-left:5px">
                                <button type="button" class="btn btn-primary" id="btnSave" onclick="Send()"><i class="fa fa-save"></i> Gửi</button>
                            </div>
                        </div>
                       
                    </div>
                </div>

               
            </form>
        </div>
    </div>
</div>
<script>
     function Send() {
         var param = {
             'Number': $("#txtNumber").val(),
             'Content': $("#txtContent").val(),
             'Port': $("#txtPort").val(),

         };
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("SendVTT")",
                    data: param,
                    async: true,
                    success: function (data) {
                        if (data.ResponseCode >= 0) {
                            alert('Thành công');
                        }
                        else {

                            alert('Thất bại');
                        }
                    }
                });
            }
</script>
