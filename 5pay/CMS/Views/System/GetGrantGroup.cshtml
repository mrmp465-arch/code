@using CMS.Models
@using CMS.Utility
@using CMS.Data.DTO
@model UserFunctionModel

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Subheader-->
    <div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
        <div class="container-fluid ">
            <!--begin::Details-->
            <div class="filter-inline mr-2">
                <!--begin::Title-->
                <div class="filter-form mb-2  align-items-center">
                    <h5 class="text-dark font-weight-bold mt-2 mb-2 mr-5">@ViewBag.Title</h5>
                </div>


            </div>
            <!--end::Details-->
            <!--begin::Toolbar-->
            <!--end::Toolbar-->
        </div>
    </div>
    <!--end::Subheader-->
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container">
            <!--begin::Card-->
            <div class="card card-custom gutter-b">
                @if (Model != null && Model.ListFunction.Count > 0)
                {
                    var fathers = Model.ListFunction.FindAll(fa => fa.FatherID == 0);
                    fathers.Sort((f1, f2) => f1.Order.CompareTo(f2.Order));
                    if (fathers != null && fathers.Count > 0)
                    {
                        foreach (var far in fathers)
                        {
                            var listChirl = Model.ListFunction.FindAll(f => f.FatherID == far.FunctionID && f.IsActive);
                            listChirl.Sort((f1, f2) => f1.Order.CompareTo(f2.Order));
                            <div class="card card-custom">
                                <div class="card-header">
                                    <h3 class="panel-title">
                                        <a data-toggle="collapse" class="panel_collapse" data-parent="#steps" href="#step_@far.FunctionID">
                                            @far.FunctionName
                                        </a>
                                    </h3>

                                </div>
                                <div class="card-body">
                                    <div>
                                        @if (listChirl != null && listChirl.Count > 0)
                                        {
                                            <div class="table-responsive">

                                                <div class="dataTables_wrapper form-inline" role="grid">
                                                    <table class="table  table-bordered dataTable no-footer" id="dataTables" >
                                                        <thead>
                                                            <tr>
                                                                <th>Chức năng cha</th>
                                                                <th>Mã chức năng</th>
                                                                <th>Tên chức năng</th>
                                                                <th>Xem</th>
                                                                <th>Thêm</th>
                                                                <th>Sửa</th>
                                                                <th>Xóa</th>
                                                                <th>FullControl</th>
                                                            </tr>
                                                        </thead>
                                                        @foreach (var function in listChirl)
                                                        {


                                                            var findUF = Model.UserFunction.Find(uf => uf.FunctionID == function.FunctionID);
                                                            if (findUF == null)
                                                            {
                                                                <tr style="" data-code="@function.FunctionCode">
                                                                    <td>@function.FatherName</td>
                                                                    <td>@function.FunctionCode</td>
                                                                    <td style="text-align:left"><i class="@function.IconId"></i>@function.FunctionName</td>

                                                                    <td><input class="grantUFRead case" type="checkbox" id="cbIsRead_@function.FunctionID" /></td>

                                                                    <td><input class="grantUF case" type="checkbox" id="cbIsInsert_@function.FunctionID" /></td>
                                                                    <td><input class="grantUF case" type="checkbox" id="cbIsUpdate_@function.FunctionID" /></td>
                                                                    <td><input class="grantUF case" type="checkbox" id="cbIsDelete_@function.FunctionID" /></td>
                                                                    <td><input class="grantUFRead case" type="checkbox" id="cbIsFull_@function.FunctionID" /></td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                <tr style="" data-code="@function.FunctionCode">
                                                                    <td>@findUF.FatherName</td>
                                                                    <td>@findUF.FunctionCode</td>
                                                                    <td style="text-align:left"><i class="@function.IconId"></i>@function.FunctionName</td>

                                                                    <td><input class="grantUFRead case" type="checkbox" checked id="cbIsRead_@function.FunctionID" /></td>
                                                                    <td>
                                                                        @if (findUF.IsInsert || findUF.IsFullControl)
                                                                        {<input class="grantUF case" type="checkbox" checked id="cbIsInsert_@function.FunctionID" />}
                                                                        else
                                                                        { <input class="grantUF case" type="checkbox" id="cbIsInsert_@function.FunctionID" />}
                                                                    </td>
                                                                    <td>
                                                                        @if (findUF.IsUpdate || findUF.IsFullControl)
                                                                        {<input class="grantUF case" type="checkbox" checked id="cbIsUpdate_@function.FunctionID" />}
                                                                        else
                                                                        { <input class="grantUF case" type="checkbox" id="cbIsUpdate_@function.FunctionID" />}
                                                                    </td>
                                                                    <td>
                                                                        @if (findUF.IsDelete || findUF.IsFullControl)
                                                                        {<input class="grantUF case" type="checkbox" checked id="cbIsDelete_@function.FunctionID" />}
                                                                        else
                                                                        {<input class="grantUF case" type="checkbox" id="cbIsDelete_@function.FunctionID" />}
                                                                    </td>
                                                                    <td>
                                                                        @if (findUF.IsFullControl)
                                                                        {<input class="grantUFRead case" type="checkbox" checked id="cbIsFull_@function.FunctionID" />}
                                                                        else
                                                                        {<input class="grantUFRead case" type="checkbox" id="cbIsFull_@function.FunctionID" />}
                                                                    </td>
                                                                </tr>
                                                            }




                                                        }

                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary" id="btnSave">Lưu lại</button>
                    <button type="button" class="btn btn-secondary" id="btnBack" onclick="GotoListpage();">Quay lại</button>

                </div>
            </div>
            <!--end::Card-->

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<script type="text/javascript">
     function GotoListpage() {
        window.location = "@Url.Action("GroupPermisstion")";
    }
        $(document).ready(function () {
            var ListGrant = [];

            $("#btnSave").click(function () {
                //input[type=checkbox]:checked
                var UserId = parseInt('@ViewBag.GroupId');
                $("#dataTables tbody").find("tr").has(".grantUFRead:checked").each(function () {
                    var functionId = $(this).find(".grantUFRead:checked").attr("id").split('_')[1];
                    var functionCode = $(this).attr("data-code");
                    var IsInsert = $("#cbIsInsert_" + functionId).is(":checked") ? true : false;
                    var IsUpdate = $("#cbIsUpdate_" + functionId).is(":checked") ? true : false;
                    var IsDelete = $("#cbIsDelete_" + functionId).is(":checked") ? true : false;
                    var IsFullControl = $("#cbIsFull_" + functionId).is(":checked") ? true : false;
                    ListGrant.push({ userID: UserId, functionID: functionId, isInsert: IsInsert, isUpdate: IsUpdate, isDelete: IsDelete, isFullControl: IsFullControl, functionCode: functionCode})
                });
                console.log(ListGrant);
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:  "@Url.Action("SaveGrantGroup")",
                    data: JSON.stringify(ListGrant),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            bootbox.alert(data.Description);
                            //setTimeout(function () { GotoListpage(); }, 2000);
                        }
                        else {

                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            });
        });


        //Check All
        //$(".case").on("mouseover", function () {
        //    this.checked = !this.checked;
        //});
</script>