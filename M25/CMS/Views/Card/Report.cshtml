@using Libs.Report
@using Libs.API
@{
    List<Partners> PartList = ViewBag.PartList;
    List<Providers> ProviderList = ViewBag.ProviderList;
}
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Subheader-->
    <div class="subheader py-2 py-lg-4 subheader-solid" id="kt_subheader">
        <div class="container-fluid ">
            <!--begin::Details-->
            <div class="filter-inline mr-2">
                <!--begin::Title-->
                <div class="filter-form mb-2  align-items-center">
                    <h5 class="text-dark font-weight-bold mt-2 mb-2 mr-5">@ViewBag.Title</h5>
                </div>
                <!--end::Title-->
                <!--begin::Separator-->
                <!--end::Separator-->
                <!--begin::Search Form-->

                <div class="filter-form mb-2  " @if (PartList.Count <= 1) { @Html.Raw("style='display:none'") ; }>

                    <form class="ml-5">

                        <div class="input-group input-group-sm " style="max-width: 175px">

                            <select class="form-control" id="ddlPartner">
                                @if (PartList != null && PartList.Count > 0)
                                {

                                    foreach (var obj in PartList)
                                    {
                                        <option value="@obj.PartnerCode">@obj.Name</option>
                                    }

                                }
                            </select>
                        </div>
                    </form>
                </div>
                <div class="filter-form mb-2  " style="display:none">

                    <form class="ml-5">

                        <div class="input-group input-group-sm " style="max-width: 175px">
                            <label class="control-label mt-3 mr-2">NCC</label>
                            <select class="form-control" id="ddlProvider">
                                @if (ProviderList != null && ProviderList.Count > 0)
                                {

                                    foreach (var obj in ProviderList)
                                    {
                                        <option value="@obj.ProviderCode">@obj.Name</option>
                                    }

                                }
                            </select>
                        </div>
                    </form>
                </div>
                <div class="filter-form mb-2  ">

                    <form class="ml-5">

                        <div class="input-group input-group-sm " style="max-width: 175px">

                            <select class="form-control" id="ddlYear">
                                @for (var i = 2023; i <= DateTime.Now.Year; i++)
                                {

                                    if (i == DateTime.Now.Year)
                                    {
                                        <option value="@i" selected="selected"> @(i)</option>
                                    }
                                    else
                                    {
                                        <option value="@i"> @(i)</option>
                                    }

                                }

                            </select>
                        </div>
                    </form>
                </div>
                <div class="filter-form mb-2  ">

                    <form class="ml-5">

                        <div class="input-group input-group-sm " style="max-width: 175px">

                            <select class="form-control" id="ddlMonth">
                                @for (var i = 1; i <= 12; i++)
                                {

                                    if (i == DateTime.Now.Month)
                                    {
                                        <option value="@i" selected="selected"> @(i)</option>
                                    }
                                    else
                                    {
                                        <option value="@i"> @(i)</option>
                                    }

                                }
                            </select>
                        </div>
                    </form>
                </div>
                <div class="filter-form mb-2  ">

                    <form class="ml-5">

                        <div class="input-group input-group-sm " style="max-width: 175px">

                            <select class="form-control" id="ddlDay">
                                <option value="0">Ngày</option>
                                @for (var i = 1; i <= 31; i++)
                                {

                                    if (i == DateTime.Now.Day)
                                    {
                                        <option value="@i" selected="selected"> @(i)</option>
                                    }
                                    else
                                    {
                                        <option value="@i"> @(i)</option>
                                    }

                                }
                            </select>
                        </div>
                    </form>
                </div>
                <div class="float-right filter-form  align-items-end">

                    <!--begin::Button-->
                    <a href="javascript:;" id="btnSearch" class="float-right mb-2 btn btn-success font-weight-bold py-2 px-5 ml-2">Tra cứu</a>
                    <!--end::Button-->

                </div>
                <!--end::Search Form-->

            </div>
            <!--end::Details-->
            <!--begin::Toolbar-->
            <!--end::Toolbar-->
        </div>
    </div>
    <!--end::Subheader-->
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container">
            <!--begin::Card-->
            <div class="card card-custom gutter-b">
                <div class="card-body">

                    <div class="table-responsive">
                        <div class="datatable datatable-bordered datatable-head-custom datatable-default datatable-primary datatable-loaded" id="ListUserLog" style="position: static; zoom: 1;">

                        </div>
                    </div>

                    <div class="datatable-pager datatable-paging-loaded" id="pager">
                    </div>

                </div>

            </div>
            <!--end::Card-->

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<<script type="text/javascript">
    $(document).ready(function () {

        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlStatus").change(function () {
            GetList(1);
        });
        $("#ddlCardType").change(function () {
            GetList(1);
        });
        $("#ddlProvider").change(function () {
            GetList(1);
        });
        $("#ddlPartner").change(function () {
            GetList(1);
        });
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        function GetList(currentPage) {
            parameters = {

                'Year': $("#ddlYear").val(),
                'Month': $("#ddlMonth").val(),
                'Day': $("#ddlDay").val(),
                //'cardType': $("#ddCardType").val(),
                'partner': $("#ddlPartner").val(),
                'provider': $("#ddlProvider").val(),
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns =  "@Url.Action("ListCardReport")";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListUserLog").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }
        GetList(1);
    });

</script>