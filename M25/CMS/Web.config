<configuration>
  <connectionStrings>
    <add name="MainConnectionString" connectionString="" providerName="System.Data.SqlClient"/>
    <add name="VPGAPIReportConnectionStrings" connectionString=""/>
    <add name="VPGLogReportConnectionStrings" connectionString=""/>
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="Salt" value=""/>
    <add key="SiteName" value="CMS"/>
    <add key="DefaultPassword" value="abc123"/>
    <add key="aspnet:MaxJsonDeserializerMembers" value="1500000"/>
    <add key="rediscacheserver" value="127.0.0.1|6379|2"/>
  </appSettings>
  <!--
