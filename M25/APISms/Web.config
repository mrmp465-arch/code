<?xml version="1.0"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.6.2"/>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
  <add key="EnableDataCaching" value="true"/>
  <add key="RedisPort" value="6379"/>
  <add key="RedisDB" value="1"/>
  <add key="RedisServer" value="127.0.0.1"/>
  <connectionStrings>
    <add name="VPGAPIConnectionStrings" connectionString=""/>
    <add name="VPGLogConnectionStrings" connectionString=""/>
    <add name="VPGAPIReportConnectionStrings" connectionString=""/>
    <add name="VPGLogReportConnectionStrings" connectionString=""/>
  </connectionStrings>
</configuration>