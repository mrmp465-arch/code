<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Layout.master.cs" Inherits="Layout_Layout" %>

<%@ Register Src="~/Layout/Header.ascx" TagName="HeaderControl" TagPrefix="uc" %>
<%@ Register Src="~/Layout/TopMenu.ascx" TagName="TopMenuControl" TagPrefix="uc" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>PaymentCMS</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <!-- Bootstrap 3.3.7 -->
    <link href="/Content/bower_components/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/Content/bower_components/font-awesome/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="/Content/bower_components/Ionicons/css/ionicons.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="/Content/dist/css/AdminLTE.min.css">
    <link rel="stylesheet" href="/Content/dist/css/skins/_all-skins.min.css">

    <link rel="stylesheet" href="/Content/table/css/dataTables.bootstrap.min.css">
    <link rel="stylesheet" href="/Content/table/css/fixedHeader.bootstrap.min.css">
    <link rel="stylesheet" href="/Content/table/css/responsive.bootstrap.min.css">


    <link rel='shortcut icon' type='image/x-icon' href='/favicon.ico' />

    <!--[if lt IE 9]>
  <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
  <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
  <![endif]-->

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
    <script src="/Content/bower_components/jquery/dist/jquery.min.js"></script>
    <script src="/Content/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/Content/dist/js/adminlte.min.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>
<body class="hold-transition skin-yellow-light sidebar-mini">
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true"></asp:ScriptManager>

        <div class="wrapper">
            <header class="main-header">
                <!-- Logo -->
                <a href="<%=Constant.ADMIN_PATH %>" class="logo">
                    <!-- mini logo for sidebar mini 50x50 pixels -->
                    <span class="logo-mini"><b>Gate</b></span>
                    <!-- logo for regular state and mobile devices -->
                    <span class="logo-lg"><b>Luffy</b>Gate</span>
                </a>
                <!-- Header Navbar: style can be found in header.less -->
                <nav class="navbar navbar-static-top">
                    <!-- Sidebar toggle button-->
                    <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </a>

                    <div class="navbar-custom-menu">
                        <ul class="nav navbar-nav">
                            <!-- User Account: style can be found in dropdown.less -->
                            <uc:HeaderControl runat="server" ID="HeaderControl" />
                            <!-- Control Sidebar Toggle Button -->
                        </ul>
                    </div>
                </nav>
            </header>
            <!-- Left side column. contains the logo and sidebar -->
            <aside class="main-sidebar">
                <!-- sidebar: style can be found in sidebar.less -->
                <section class="sidebar">
                    <uc:TopMenuControl runat="server" ID="TopMenuControl" />
                    <!-- sidebar menu: : style can be found in sidebar.less -->

                </section>
                <!-- /.sidebar -->
            </aside>

            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <!-- /.content-wrapper -->
            <footer class="main-footer">
                <div class="pull-right hidden-xs">
                    <b>Version</b> 1.0
                </div>
                <strong>&copy; 2017 </strong>All rights
            reserved.
            </footer>
            <!-- /.control-sidebar -->
            <!-- Add the sidebar's background. This div must be placed
               immediately after the control sidebar -->
            <div class="control-sidebar-bg"></div>
        </div>



        <script src="<%=Constant.ADMIN_PATH %>Content/table/js/jquery.dataTables.min.js"></script>
        <script src="<%=Constant.ADMIN_PATH %>Content/table/js/dataTables.bootstrap.min.js"></script>
        <script src="<%=Constant.ADMIN_PATH %>Content/table/js/dataTables.fixedHeader.min.js"></script>
        <script src="<%=Constant.ADMIN_PATH %>Content/table/js/dataTables.responsive.min.js"></script>
        <script src="<%=Constant.ADMIN_PATH %>Content/table/js/responsive.bootstrap.min.js"></script>


        <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>
