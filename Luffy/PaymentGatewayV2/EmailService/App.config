<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=HP\SQLEXPRESS;Initial Catalog=TokenAuthenticationDB;Persist Security Info=True;integrated security=True;multipleactiveresultsets=True;" providerName="System.Data.SqlClient"/>
    <add name="VPGAPIConnectionStrings" connectionString=""/>
    <add name="VPGLogConnectionStrings" connectionString=""/>
    <add name="VPGAPIReportConnectionStrings" connectionString=""/>
    <add name="VPGLogReportConnectionStrings" connectionString=""/>
    <add name="CardStoreConnectionStrings" connectionString=""/>
    <add name="CardStoreReportConnectionStrings" connectionString=""/>
  </connectionStrings>
  <appSettings>
    <!--Cache-->
    <add key="EnableDataCaching" value="false"/>
    <add key="RedisPort" value="6379"/>
    <add key="RedisDB" value="1"/>
    <add key="RedisServer" value="127.0.0.1"/>
    <!--End Cache-->

    <!--FailOver-->
    <!--<add key="NAME_CHECK" value="Payment" />
    <add key="ENABLE_FAIL_OVER" value="true" />
    <add key="PROCESS_INTERVAL" value="0.2" />
    <add key="TOP_RAW_CHECK" value="20" />
    <add key="CARD_TYPE_CHECK" value="viettel|vms|vnp" />-->
    <!--End FailOver-->

    <!--Auto BuyCard-->
    <add key="PROCESS_INTERVAL" value="5"/>
    <add key="CARD_PER_REQUEST" value="100"/>
    <!--End Auto BuyCard-->



  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
